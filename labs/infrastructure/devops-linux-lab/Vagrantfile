# DESCRIPTION
# -----------------------------------------------------------------------------
# Enterprise Kubernetes lab built with Vagrant supporting both Libvirt and
# VirtualBox providers. This unified Vagrantfile eliminates 95% duplication
# while maintaining provider-specific optimizations.
#
# The lab code is split into vagrant/*.rb, loaded in order below; this file
# keeps the banner and the Vagrant.configure block.
#
# Usage:
#   # Libvirt (KVM)
#   vagrant up --provider=libvirt
#
#   # VirtualBox
#   vagrant up --provider=virtualbox
#
#   # Override network
#   export NETWORK_BASE="192.168.56"
#   vagrant up --provider=virtualbox
#
# =============================================================================

LAB_NAME        = "Enterprise Cloud-Native DevSecOps Lab"
LAB_VERSION     = "8.2.0"
LAB_AUTHOR      = "Miguel A. Carlo (solo2121)"
LAB_CREATED     = "2025"
LAB_UPDATED     = "2026-11-27"
LAB_STATUS      = "Active & Maintained"

puts "=================================================="
puts "#{LAB_NAME}"
puts "Version      : #{LAB_VERSION}"
puts "Author       : #{LAB_AUTHOR}"
puts "Last Updated : #{LAB_UPDATED}"
puts "Status       : #{LAB_STATUS}"
puts "=================================================="

require 'ipaddr'
require 'io/console'
require 'shellwords'
require 'fileutils'
require 'rexml/document'

Vagrant.require_version ">= 2.4.0"

# ------------------------------------------------------------
# LAB CODE (vagrant/) - loaded in this order; the order matters
# because each file may use constants defined by the ones before it.
# ------------------------------------------------------------
require_relative 'vagrant/provision'        # LAB_DIR, PROVISION_DIR, render_provision
require_relative 'vagrant/provider'         # PROVIDER
require_relative 'vagrant/host'             # host OS and resource check
require_relative 'vagrant/network'          # network, NETWORK_BASE, MASTER_IP, /tmp/lab.env
require_relative 'vagrant/settings'         # LAB_PROFILE, LAB_GUI, START_VMS, ...
require_relative 'vagrant/versions'         # pinned versions and ports
require_relative 'vagrant/harbor'           # HARBOR_VMS, HARBOR_PASSWORD (may prompt)
require_relative 'vagrant/airgap'           # AIRGAP_IMAGES
require_relative 'vagrant/helpers'          # should_start?, DEFAULT
require_relative 'vagrant/providers'        # libvirt / VirtualBox hardware and disks
require_relative 'vagrant/cluster'          # VM tables, VMS_TO_START, HOSTS_ENTRIES
require_relative 'vagrant/global'           # configure_global
require_relative 'vagrant/machine'          # define_vm
require_relative 'vagrant/roles/master'
require_relative 'vagrant/roles/worker'
require_relative 'vagrant/roles/lab'
require_relative 'vagrant/roles/kind'
require_relative 'vagrant/roles/k3d'
require_relative 'vagrant/roles/cicd'

# =============================================================================
# VAGRANT CONFIGURATION
# =============================================================================
Vagrant.configure("2") do |config|
  configure_global(config)

  VMS_TO_START.each do |name, cfg|
    define_vm(config, name, cfg)
  end
end
