all_vms = cluster.merge(linux_labs).merge(ansible_nodes).merge(kind_labs).merge(k3d_labs).merge(cicd_server)
# Machines named explicitly on the command line (vagrant up ubuntu-lab,
# vagrant ssh ubuntu-lab, vagrant status rocky-lab, ...) are always defined,
# whatever LAB_PROFILE is. Without this, any VM outside the active profile
# fails with "The machine with the name '<vm>' was not found configured for
# this Vagrant environment."
cli_vms = ARGV.select { |arg| all_vms.key?(arg) }
vms_to_start = all_vms.select { |name, _| should_start?(name, LAB_PROFILE, START_VMS | cli_vms) }
hosts_entries = all_vms.map { |n, c| "#{c[:ip]} #{n}" }.join("\n")

# =============================================================================
# VAGRANT CONFIGURATION
# =============================================================================
Vagrant.configure("2") do |config|
  config.vm.box_check_update = false
  # /vagrant is a one-way rsync copy (host -> guest) on libvirt. The type is set
  # explicitly because, when it is left out, Vagrant picks whichever type it finds
  # usable on the host, which can be a 9p share that root inside the VM cannot
  # write to ("/vagrant/lab.env: Permission denied"). Because rsync is one-way,
  # files the master writes (.k3s_token, .cluster_state.json) are pulled back to
  # the host by a trigger on devops-1 below, and the workers receive them when
  # they boot. Start devops-1 first, then the workers.
  # SYNC_TYPE=nfs|virtiofs|9p overrides this for hosts that support it.
  if PROVIDER == :libvirt
    sync_type = ENV['SYNC_TYPE'] || "rsync"
    puts "Synced folder type: #{sync_type}"
    if sync_type == "nfs"
      config.vm.synced_folder ".", "/vagrant", type: "nfs", nfs_version: 4, nfs_udp: false
    else
      config.vm.synced_folder ".", "/vagrant", type: sync_type
    end
  else
    config.vm.synced_folder ".", "/vagrant", disabled: false
  end
  config.ssh.connect_timeout = 600
  config.vm.boot_timeout = 1200

  # VirtualBox-specific global settings
  if PROVIDER == :virtualbox
    config.vm.provider :virtualbox do |vb|
      vb.linked_clone = true
    end

    if Vagrant.has_plugin?("vagrant-vbguest")
      config.vbguest.auto_update = true
      config.vbguest.no_install = false
      config.vbguest.installer_options = { allow_kernel_upgrade: true }
    end
  end

  # Pre-flight host check
  #
  # This MUST run on the host, not inside the guest -- it checks for
  # virsh/VBoxManage, which are host-side hypervisor tools and will
  # never be present inside a stock guest VM. A `config.vm.provision`
  # "shell" block runs inside the guest, so this uses a host-side
  # `trigger.before :up` instead. Runs once per `vagrant up` invocation,
  # before any machine is created.
  config.trigger.before :up do |trigger|
    trigger.name = "Pre-flight host check"
    trigger.info = "Checking host virtualization tooling before creating any VM..."
    trigger.run = {
      path: File.expand_path("scripts/pre-flight-host-check.sh", __dir__),
      args: PROVIDER.to_s
    }
  end

  # Lab environment file
  config.vm.provision "shell", inline: render_provision("common/lab-env.sh", MASTER_IP: MASTER_IP, NETWORK_BASE: NETWORK_BASE, PROVIDER: PROVIDER, OPENTOFU_VERSION: OPENTOFU_VERSION, KIND_VERSION: KIND_VERSION, K3D_VERSION: K3D_VERSION, KUBECTL_VERSION: KUBECTL_VERSION, HARBOR_PASS: harbor_pass)

  # Snapshot trigger
  config.trigger.before :destroy do |trigger|
    trigger.name = "Snapshot warning"
    trigger.info = "VM will be destroyed. Consider taking a snapshot first: vagrant snapshot save pre-destroy"
  end

  # =========================================================================
  # VM DEFINITIONS
  # =========================================================================
  vms_to_start.each do |name, cfg|
    config.vm.define name do |vm|
      vm.vm.box = cfg[:box]
      vm.vm.hostname = name

      # Provider-specific network configuration
      if PROVIDER == :libvirt
        vm.vm.network "private_network", ip: cfg[:ip]
      else
        vm.vm.network "private_network", ip: cfg[:ip]
        vm.vm.network "forwarded_port", guest: 22, host: 2200 + cfg[:ip].split('.').last.to_i, host_ip: "127.0.0.1"
      end

      # rsync is one-way (host -> guest), so copy the files the master writes in
      # /vagrant back to the host once it is up; workers pick them up when they boot.
      if PROVIDER == :libvirt && cfg[:role] == "master" && ENV['SYNC_TYPE'].to_s.empty?
        vm.trigger.after :up do |t|
          t.name = "Pull cluster handoff files from #{name} to host"
          t.ruby do |_env, machine|
            %w[.cluster_state.json .k3s_token .cluster_ready].each do |f|
              data = +""
              begin
                machine.communicate.execute("cat /vagrant/#{f} 2>/dev/null", error_check: false) do |type, out|
                  data << out if type == :stdout
                end
              rescue StandardError => e
                puts "Could not read #{f} from #{name}: #{e.message}"
              end
              File.write(File.join(__dir__, f), data) unless data.empty?
            end
          end
        end
      end

      # Provider-specific hardware configuration
      if PROVIDER == :libvirt
        configure_libvirt(vm, memory: cfg[:memory] || 1024, cpus: cfg[:cpus] || 1)
      else
        configure_virtualbox(vm, memory: cfg[:memory] || 1024, cpus: cfg[:cpus] || 1)
      end

      # Attach extra disks for lab VMs
      attach_disks(vm, name) if linux_labs.key?(name)

      # /etc/hosts configuration
      vm.vm.provision "shell", run: "always", inline: render_provision("common/lab-hosts.sh", HOSTS_ENTRIES: hosts_entries)

      # Base provisioning
      vm.vm.provision "shell", inline: render_provision("common/base.sh")

      # =====================================================================
      # ROLE-SPECIFIC PROVISIONING
      # =====================================================================
      case cfg[:role]
      when "master"
        # Port forwarding
        vm.vm.network "forwarded_port", guest: 80, host: 8080, host_ip: "127.0.0.1"
        vm.vm.network "forwarded_port", guest: 443, host: 8443, host_ip: "127.0.0.1"
        vm.vm.network "forwarded_port", guest: 6443, host: K8S_API_HOST_PORT.to_i, host_ip: "127.0.0.1"
        vm.vm.network "forwarded_port", guest: 30001, host: 30001, host_ip: "127.0.0.1"
        vm.vm.network "forwarded_port", guest: 30003, host: 30003, host_ip: "127.0.0.1"
        vm.vm.network "forwarded_port", guest: 30004, host: 30004, host_ip: "127.0.0.1"

        # ===================================================================
        # PROVISIONER 1: BASE LAB + K3S + HARBOR
        # ===================================================================
        vm.vm.provision "shell", inline: render_provision("master/01-base-k3s-harbor.sh", CFG_IP: cfg[:ip], HARBOR_PROJECT: HARBOR_PROJECT, HARBOR_CHART_VERSION: HARBOR_CHART_VERSION, INGRESS_NGINX_VERSION: INGRESS_NGINX_VERSION, K3S_VERSION: K3S_VERSION, DOCKER_VERSION: DOCKER_VERSION, HARBOR_PASS_ESCAPED: Shellwords.escape(harbor_pass), FAST_BOOT: FAST_BOOT, LAB_PROFILE: LAB_PROFILE, K8S_API_HOST_PORT: K8S_API_HOST_PORT, CACHE_MODE: CACHE_MODE, PROVIDER: PROVIDER, AIRGAP_IMAGES_LIST: AIRGAP_IMAGES.map { |image| "\"#{image}\"" }.join("\n"), HELM_VERSION: HELM_VERSION)

        # ===================================================================
        # PROVISIONER 2: ENTERPRISE TOOLS
        # ===================================================================
        vm.vm.provision "shell", inline: render_provision("master/02-enterprise-tools.sh", CFG_IP: cfg[:ip], ARGOCD_VERSION: ARGOCD_VERSION, PROMETHEUS_VERSION: PROMETHEUS_VERSION, FALCO_VERSION: FALCO_VERSION, KYVERNO_VERSION: KYVERNO_VERSION, CERT_MANAGER_VERSION: CERT_MANAGER_VERSION, TERRAFORM_VERSION: TERRAFORM_VERSION, OPENTOFU_VERSION: OPENTOFU_VERSION, FAST_BOOT: FAST_BOOT)

        # ===================================================================
        # PROVISIONER 3: DEVSECOPS ATTACK VECTORS
        # ===================================================================
        vm.vm.provision "shell", inline: render_provision("master/03-devsecops-attack-vectors.sh", CFG_IP: cfg[:ip], HARBOR_PASS_ESCAPED: Shellwords.escape(harbor_pass))

      when "worker"
        vm.vm.provision "shell", inline: render_provision("worker/worker-join.sh", MASTER_IP: MASTER_IP, CFG_IP: cfg[:ip], NAME: name)

      when "lab", "ansible"
        vm.vm.provision "shell", inline: render_provision("ansible/lab-ssh-setup.sh")

      when "kind"
        vm.vm.network "forwarded_port", guest: 6443, host: 26443, host_ip: "127.0.0.1"

        vm.vm.provision "shell", inline: render_provision("common/enable-docker.sh")

        vm.vm.provision "shell", inline: render_provision("kind/kind-cluster.sh")

      when "k3d"
        vm.vm.network "forwarded_port", guest: 6443, host: 26444, host_ip: "127.0.0.1"
        vm.vm.network "forwarded_port", guest: 8080, host: 28080, host_ip: "127.0.0.1"

        vm.vm.provision "shell", inline: render_provision("common/enable-docker.sh")

        vm.vm.provision "shell", inline: render_provision("k3d/k3d-cluster.sh", HELM_VERSION: HELM_VERSION)

      when "cicd"
        vm.vm.network "forwarded_port", guest: GITEA_PORT, host: GITEA_PORT, host_ip: "127.0.0.1"
        vm.vm.network "forwarded_port", guest: JENKINS_PORT, host: JENKINS_HOST_PORT, host_ip: "127.0.0.1"
        vm.vm.network "forwarded_port", guest: SONARQUBE_PORT, host: SONARQUBE_PORT, host_ip: "127.0.0.1"
        vm.vm.network "forwarded_port", guest: VAULT_PORT, host: VAULT_PORT, host_ip: "127.0.0.1"
        vm.vm.network "forwarded_port", guest: ZAP_PORT, host: ZAP_PORT, host_ip: "127.0.0.1"
        vm.vm.network "forwarded_port", guest: JENKINS_AGENT_PORT, host: JENKINS_AGENT_PORT, host_ip: "127.0.0.1"

        vm.vm.provision "shell", inline: render_provision("common/enable-docker.sh")

        vm.vm.provision "shell", inline: render_provision("cicd/cicd-tools.sh", CFG_IP: cfg[:ip], HARBOR_PASS_ESCAPED: Shellwords.escape(harbor_pass), FAST_BOOT: FAST_BOOT, GITEA_VERSION: GITEA_VERSION, JENKINS_VERSION: JENKINS_VERSION, SONARQUBE_VERSION: SONARQUBE_VERSION, VAULT_VERSION: VAULT_VERSION, ZAP_VERSION: ZAP_VERSION, GITLEAKS_VERSION: GITLEAKS_VERSION, TRIVY_VERSION: TRIVY_VERSION, GITEA_PORT: GITEA_PORT, JENKINS_PORT: JENKINS_PORT, SONARQUBE_PORT: SONARQUBE_PORT, VAULT_PORT: VAULT_PORT, ZAP_PORT: ZAP_PORT, JENKINS_AGENT_PORT: JENKINS_AGENT_PORT)
      end
    end
  end
end
