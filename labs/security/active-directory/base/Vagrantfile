DEFAULT_CONFIG = {
  memory: 1024,
  cpus: 1,
  disk_bus: "virtio",
  nic_model_type: "virtio",
  video_type: "vga",
  video_vram: 16384
}.freeze

WINDOWS_CONFIG = {
  memory: 2048,
  cpus: 2,
  disk_size: 40,
  nic_model_type: "e1000e",
  guest: :windows,
  communicator: "winrm",
  boot_timeout: 7200,
  video_type: "vga",
  video_vram: 16384
}.freeze

# ------------------------------------------------------------
# NETWORK FUNCTION - STATIC IP ONLY, NO DHCP (provider-aware)
# ------------------------------------------------------------
def configure_network(vm, ip)
  if PROVIDER == :libvirt
    vm.vm.network :private_network,
      ip: ip,
      libvirt__network_name: LAB_NET,
      libvirt__forward_mode: "none",
      libvirt__dhcp_enabled: false,
      libvirt__driver_name: "qemu",
      auto_config: false
  else
    vm.vm.network "private_network", ip: ip, virtualbox__intnet: "pentest_lab"
  end
end

# ------------------------------------------------------------
# LIBVIRT PROVIDER CONFIG
# ------------------------------------------------------------
def configure_libvirt(vm, overrides = {})
  settings = DEFAULT_CONFIG.merge(overrides)

  vm.vm.provider :libvirt do |libvirt|
    libvirt.memory = settings[:memory]
    libvirt.cpus = settings[:cpus]
    libvirt.disk_bus = settings[:disk_bus]
    libvirt.nic_model_type = settings[:nic_model_type]
    libvirt.video_type = settings[:video_type]
    libvirt.video_vram = settings[:video_vram]
    libvirt.default_prefix = ""
    libvirt.nested = true
    libvirt.graphics_type = "vnc"
    libvirt.graphics_ip = "127.0.0.1"
    libvirt.video_accel3d = false
    libvirt.qemu_use_session = false
    libvirt.uri = 'qemu:///system'
    libvirt.mgmt_attach = true

    if settings[:guest] == :windows
      libvirt.cpu_mode = "host-passthrough"
      libvirt.cpu_model = "host"

      # Safely configure channel if method exists
      if libvirt.respond_to?(:channel)
        begin
          libvirt.channel type: "unix",
                          target_name: "org.qemu.guest_agent.0",
                          target_type: "virtio"
        rescue => e
          puts "[WARN] Failed to configure guest agent channel: #{e.message}"
        end
      end
    end

    if settings[:disk_size]
      libvirt.storage :file,
        size: "#{settings[:disk_size]}G",
        type: "qcow2",
        bus: "virtio"
    end
  end
end

# ------------------------------------------------------------
# VIRTUALBOX PROVIDER CONFIG
# ------------------------------------------------------------
def configure_virtualbox(vm, overrides = {})
  settings = DEFAULT_CONFIG.merge(overrides)

  vm.vm.provider :virtualbox do |vb|
    vb.memory = settings[:memory]
    vb.cpus = settings[:cpus]
    vb.gui = LAB_GUI
    vb.linked_clone = true

    # Enable hardware virtualization for better performance
    vb.customize ["modifyvm", :id, "--vtxvpid", "on"]
    vb.customize ["modifyvm", :id, "--vtxux", "on"]
    vb.customize ["modifyvm", :id, "--hwvirtex", "on"]
    vb.customize ["modifyvm", :id, "--nestedpaging", "on"]
    vb.customize ["modifyvm", :id, "--largepages", "on"]

    # Network settings
    vb.customize ["modifyvm", :id, "--nictype1", "virtio"]
    vb.customize ["modifyvm", :id, "--nictype2", "virtio"]

    # Graphics settings for Windows
    if settings[:guest] == :windows
      vb.customize ["modifyvm", :id, "--vram", "128"]
      vb.customize ["modifyvm", :id, "--graphicscontroller", "vboxsvga"]
      vb.customize ["modifyvm", :id, "--audio", "none"]
      vb.customize ["modifyvm", :id, "--usb", "on"]
      vb.customize ["modifyvm", :id, "--usbehci", "on"]
    end

    # Performance optimizations
    vb.customize ["modifyvm", :id, "--ioapic", "on"]
    vb.customize ["modifyvm", :id, "--rtcuseutc", "on"]

    # Network adapter order: NAT for internet, Host-Only for lab
    vb.customize ["modifyvm", :id, "--nic1", "nat"]
    vb.customize ["modifyvm", :id, "--nic2", "hostonly"]
  end
end

# ------------------------------------------------------------
# PROVIDER DISPATCH - calls the configuration function matching
# the active PROVIDER so call sites don't need to branch.
# ------------------------------------------------------------
def configure_provider(vm, overrides = {})
  if PROVIDER == :libvirt
    configure_libvirt(vm, overrides)
  else
    configure_virtualbox(vm, overrides)
  end
end

# ------------------------------------------------------------
# WINDOWS COMMUNICATION - WITH TIMEOUT PARAMETER FOR FLEXIBILITY
# ------------------------------------------------------------
def configure_windows_comm(vm, user, pass, boot_timeout = 7200, winrm_timeout = 3600)
  vm.vm.communicator = "winrm"
  vm.vm.guest = :windows
  vm.vm.boot_timeout = boot_timeout

  vm.winrm.username = user
  vm.winrm.password = pass
  vm.winrm.transport = :plaintext
  vm.winrm.port = 5985
  vm.winrm.retry_limit = 240
  vm.winrm.retry_delay = 30
  vm.winrm.timeout = winrm_timeout
  vm.winrm.basic_auth_only = true

  # VirtualBox-specific Windows settings (Vagrant only applies this block
  # when actually running under the virtualbox provider)
  vm.vm.provider :virtualbox do |vb|
    vb.customize ["modifyvm", :id, "--natdnshostresolver1", "on"]
    vb.customize ["modifyvm", :id, "--natdnsproxy1", "on"]
  end
end

# ------------------------------------------------------------
# FIXED WINDOWS STATIC IP CONFIGURATION
# 5-Method adapter detection with DAD disabled and SkipAsSource=false
# ------------------------------------------------------------
def configure_windows_static_ip(vm, ip)
  # Adapter naming and the provider's NAT range differ between providers:
  # libvirt commonly surfaces the lab NIC as "Ethernet 1" with the default
  # NAT network on 192.168.121.0/24, while VirtualBox surfaces it as
  # "Ethernet"/"Ethernet 2" with NAT on 10.0.2.0/24.
  if PROVIDER == :libvirt
    adapter_detect_ps = read_provision("windows/fragments/adapter-detect-libvirt.ps1.frag")
  else
    adapter_detect_ps = read_provision("windows/fragments/adapter-detect-virtualbox.ps1.frag")
  end

  vm.vm.provision "shell",
    name: "fixed-static-ip",
    privileged: true,
    run: "once",
    inline: render_provision("windows/static-ip.ps1", IP: ip, ADAPTER_DETECT: adapter_detect_ps, DC_IP: DC_IP)
end

# ------------------------------------------------------------
# WINDOWS DEFENDER LAB BASELINE - REGISTRY ONLY APPROACH
# Uses minimal PowerShell commands (registry only) to avoid detection
# ------------------------------------------------------------
def disable_windows_defender(vm)
  vm.vm.provision "shell",
    name: "disable-defender",
    privileged: true,
    run: "once",
    inline: render_provision("windows/disable-defender.ps1")
end

# ------------------------------------------------------------
# SAFE INTERNET ISOLATION FUNCTION - WORKING VERSION FROM 1.2
# ------------------------------------------------------------
def disable_internet_gateway(vm, vm_name)
  # The NAT adapter's name/IP range differs between providers: libvirt
  # exposes it via a virtio NIC on 192.168.121.0/24, VirtualBox names it
  # "NAT"/"VirtualBox Host-Only" on 10.0.2.0/24.
  if PROVIDER == :libvirt
    nat_match_ps = read_provision("windows/fragments/nat-match-libvirt.ps1.frag", strip: true)
  else
    nat_match_ps = read_provision("windows/fragments/nat-match-virtualbox.ps1.frag", strip: true)
  end

  vm.vm.provision "shell",
    name: "disable-internet-gateway-#{vm_name}",
    privileged: true,
    run: "once",
    inline: render_provision("windows/disable-internet-gateway.ps1", VM_NAME_UPPER: vm_name.upcase, NAT_MATCH: nat_match_ps, DC_IP: DC_IP, LAB_SUBNET: LAB_SUBNET)
end

# ------------------------------------------------------------
# WAIT FOR DC FUNCTION
# ------------------------------------------------------------
def wait_for_dc(vm, ip = DC_IP, max_attempts = 60)
  vm.vm.provision "shell",
    run: "once",
    inline: render_provision("windows/wait-for-dc.ps1", MAX_ATTEMPTS: max_attempts, IP: ip)
end

# ------------------------------------------------------------
# REUSABLE DOMAIN JOIN FUNCTION - ELIMINATES DUPLICATION
# ------------------------------------------------------------
def domain_join_windows(vm, hostname, ip, memory = 2048, disk_size = 40)
  configure_network(vm, ip)
  configure_provider(vm, WINDOWS_CONFIG.merge(memory: memory, disk_size: disk_size))
  configure_windows_static_ip(vm, ip)
  disable_windows_defender(vm)
  wait_for_dc(vm)

  vm.vm.provision "shell",
    name: "domain-join-#{hostname}",
    privileged: true,
    reboot: "always",
    inline: render_provision("windows/domain-join.ps1", HOSTNAME_UPPER: hostname.upcase, DC_IP: DC_IP, DOMAIN_JOIN_PASS_SQ: ps_squote_escape(DOMAIN_JOIN_PASS), DOMAIN_NETBIOS: DOMAIN_NETBIOS, DOMAIN_JOIN_USER: DOMAIN_JOIN_USER, DOMAIN_NAME: DOMAIN_NAME, HOSTNAME: hostname)

  vm.vm.provision :reload, name: "reboot-after-domain-join-#{hostname}"
end

# ------------------------------------------------------------
# HEALTH CHECK FUNCTION
# ------------------------------------------------------------
def add_health_check(vm, hostname, check_type = :windows)
  vm.vm.provision "shell",
    name: "health-check-#{hostname}",
    privileged: true,
    run: "once",
    inline: render_provision("windows/health-check.ps1", HOSTNAME_UPPER: hostname.upcase, DC_IP: DC_IP, HOSTNAME: hostname)
end

# ------------------------------------------------------------
# LAB HOSTS FILE HELPER - writes all lab VM entries to /etc/hosts
# Uses VM_IPS hash (single source of truth) instead of hardcoded IPs
# ------------------------------------------------------------
def write_lab_hosts(vm)
  vm.vm.provision "shell",
    name: "configure-lab-hosts",
    privileged: true,
    run: "once",
    inline: render_provision("linux/lab-hosts.sh", KALI_IP: VM_IPS[:kali], DC01_IP: VM_IPS[:dc01], DB01_IP: VM_IPS[:db01], WIN10_IP: VM_IPS[:win10], LLM01_IP: VM_IPS[:llm01], LINUX01_IP: VM_IPS[:linux01], PRINT01_IP: VM_IPS[:print01], METASPLOITABLE2_IP: VM_IPS[:metasploitable2], JUICE_SHOP_IP: VM_IPS[:juice_shop], CLOUD_PENTEST_IP: VM_IPS[:cloud_pentest], CA01_ESC_IP: VM_IPS[:ca01_esc])
end

# ============================================================
# VAGRANT MACHINES
# ============================================================
Vagrant.configure("2") do |config|

  # ----------------------------------------------------------------------------
  # PLUGIN CHECKS (INSIDE CONFIGURE BLOCK)
  # ----------------------------------------------------------------------------
  unless Vagrant.has_plugin?("vagrant-reload")
    raise "ERROR: vagrant-reload plugin is required. Please run: vagrant plugin install vagrant-reload"
  end

  if PROVIDER == :libvirt
    unless Vagrant.has_plugin?("vagrant-libvirt")
      raise "ERROR: vagrant-libvirt plugin is required. Please run: vagrant plugin install vagrant-libvirt"
    end
  end

  # ----------------------------------------------------------------------------
  # OPTIONAL PLUGINS (NICE TO HAVE)
  # ----------------------------------------------------------------------------
  if Vagrant.has_plugin?("vagrant-hostmanager")
    puts "[INFO] vagrant-hostmanager plugin detected - hosts will be auto-managed"
  end

  if Vagrant.has_plugin?("vagrant-vbguest")
    puts "[INFO] vagrant-vbguest plugin detected - guest additions will auto-update"
    if PROVIDER == :virtualbox
      config.vbguest.auto_update = true
      config.vbguest.no_install = false
    end
  end

  # ----------------------------------------------------------------------------
  # HOST MANAGER CONFIGURATION (if plugin is available)
  # ----------------------------------------------------------------------------
  if Vagrant.has_plugin?("vagrant-hostmanager")
    config.hostmanager.enabled = true
    config.hostmanager.manage_host = true
    config.hostmanager.manage_guest = true
    config.hostmanager.include_offline = true
    
    # Fixed: Properly define aliases as an array of strings
    config.hostmanager.aliases = {
      VM_IPS[:dc01] => ["dc01.lab.local", "dc01"],
      VM_IPS[:kali] => ["kali.lab.local", "kali"],
      VM_IPS[:db01] => ["db01.lab.local", "db01"],
      VM_IPS[:ca01_esc] => ["ca01-esc.lab.local", "ca01-esc"],
      VM_IPS[:win10] => ["win10.lab.local", "win10"],
      VM_IPS[:linux01] => ["linux01.lab.local", "linux01"],
      VM_IPS[:print01] => ["print01.lab.local", "print01"],
      VM_IPS[:llm01] => ["llm01.lab.local", "llm01"],
      VM_IPS[:metasploitable2] => ["metasploitable2.lab.local", "metasploitable2"],
      VM_IPS[:juice_shop] => ["juice-shop.lab.local", "juice-shop"],
      VM_IPS[:cloud_pentest] => ["cloud-pentest.lab.local", "cloud-pentest"]
    }
  end

  # ===========================================================================
  # KALI - PROFESSIONAL PENTESTING PLATFORM WITH MODERN TOOLS
  # (defaults to Kali Linux; set KALI_BOX to use Parrot Security or
  # another Debian-based box instead - see ATTACKER BOX SELECTION above)
  # ===========================================================================
  config.vm.define "kali" do |vm|
    vm.vm.box = KALI_BOX
    vm.vm.box_version = KALI_BOX_VERSION
    vm.vm.hostname = "kali.lab.local"
    configure_network(vm, VM_IPS[:kali])

    configure_provider(vm, memory: VM_MEMORY[:kali], cpus: VM_CPUS[:kali])

    write_lab_hosts(vm)

    # Runs on EVERY "vagrant up"/"vagrant reload" (not just first boot).
    # Auto-repairs any dpkg/apt state left broken by an interrupted install
    # or a manual "apt upgrade" run inside the VM, so you never have to SSH
    # in and run `dpkg --configure -a` / `apt --fix-broken install` by hand.
    vm.vm.provision "shell", name: "kali-apt-selfheal", run: "always", inline: render_provision("kali/apt-selfheal.sh")

    vm.vm.provision "shell", name: "kali-tools", inline: render_provision("kali/tools.sh")
  end

  # ===========================================================================
  # DOMAIN CONTROLLER (DC01) - WITH MODERN ATTACK VECTORS ADDED
  # CRITICAL: DC01 needs longer timeouts for AD promotion
  # ===========================================================================
  config.vm.define "dc01", primary: true do |vm|
    vm.vm.box = "peru/windows-server-2022-standard-x64-eval"
    vm.vm.hostname = "dc01"
    vm.vm.synced_folder ".", "/vagrant", disabled: true

    # CRITICAL: DC01 uses longer timeouts (7200) for AD promotion
    # Other VMs use default timeout (3600)
    configure_windows_comm(vm, "vagrant", "vagrant", 7200, 7200)

    configure_network(vm, VM_IPS[:dc01])
    configure_provider(vm, WINDOWS_CONFIG.merge(memory: VM_MEMORY[:dc01], disk_size: 60))
    configure_windows_static_ip(vm, VM_IPS[:dc01])
    disable_windows_defender(vm)

    vm.vm.provision "shell", name: "phase0-winrm-bootstrap", privileged: false, run: "once", inline: render_provision("dc01/phase0-winrm-bootstrap.ps1")

    vm.vm.provision "shell", name: "phase1-basic-setup", privileged: false, inline: render_provision("dc01/phase1-basic-setup.ps1")

    vm.vm.provision :reload, name: "reboot-after-phase1"

    vm.vm.provision "shell", name: "phase2-post-reboot-verification", privileged: false, inline: render_provision("dc01/phase2-post-reboot-verification.ps1")

    # ============================================================
    # PHASE 3 - AD PROMOTION - FIXED WITH EXPLICIT PARAMETERS
    # ============================================================
    vm.vm.provision "shell", name: "phase3-ad-promotion", privileged: false, inline: render_provision("dc01/phase3-ad-promotion.ps1", DOMAIN_NAME: DOMAIN_NAME, DOMAIN_NETBIOS: DOMAIN_NETBIOS)

    vm.vm.provision :reload, name: "reboot-after-ad-promotion"

    vm.vm.provision "shell", name: "phase4-winrm-stabilizer", privileged: true, inline: render_provision("dc01/phase4-winrm-stabilizer.ps1")

    # ============================================================
    # PHASE 5 - FULL DC CONFIG - WITH MODERN ATTACK VECTORS ADDED
    # FIX: Domain name hardcoded as "lab.local" for PowerShell
    # FIX: DNS records hardcoded with IP addresses
    # ============================================================
    # CHANGED: Heredoc kept as <<-'SHELL' to prevent Ruby syntax errors on reg add backslashes.
    # Using .gsub to safely inject DOMAIN_JOIN_PASS without triggering Ruby interpolation.
    vm.vm.provision "shell",
      name: "phase5-full-dc-config",
      privileged: true,
      inline: render_provision("dc01/phase5-full-dc-config.ps1", DOMAIN_JOIN_PASS_DQ: ps_dquote_escape(DOMAIN_JOIN_PASS))

    vm.vm.provision "shell", name: "phase6-cleanup", privileged: true, run: "once", inline: render_provision("dc01/phase6-cleanup.ps1")

    vm.vm.provision :reload, name: "final-reboot"
    disable_internet_gateway(vm, "dc01")
    add_health_check(vm, "dc01")
  end

  # ===========================================================================
  # DB01
  # ===========================================================================
  if profile_includes?("db01")
  config.vm.define "db01" do |vm|
    vm.vm.box = "peru/windows-server-2022-standard-x64-eval"
    vm.vm.hostname = "db01"
    vm.vm.synced_folder ".", "/vagrant", disabled: true
    # Use default timeouts for non-DC VMs
    configure_windows_comm(vm, "vagrant", "vagrant")
    
    domain_join_windows(vm, "DB01", VM_IPS[:db01], VM_MEMORY[:db01], 40)

    vm.vm.provision "shell", name: "sql-config", privileged: true, inline: render_provision("db01/sql-config.ps1")

    disable_internet_gateway(vm, "db01")
    add_health_check(vm, "db01")
  end
  end

  # ===========================================================================
  # CA01-ESC - FULL AD CS VULNERABILITIES FOR ESC ATTACKS
  # ===========================================================================
  if profile_includes?("ca01-esc")
  config.vm.define "ca01-esc" do |vm|
    vm.vm.box = "peru/windows-server-2022-standard-x64-eval"
    vm.vm.hostname = "ca01-esc"
    vm.vm.synced_folder ".", "/vagrant", disabled: true
    # Use default timeouts for non-DC VMs
    configure_windows_comm(vm, "vagrant", "vagrant")
    
    domain_join_windows(vm, "CA01-ESC", VM_IPS[:ca01_esc], VM_MEMORY[:ca01_esc], 60)

    vm.vm.provision "shell", name: "adcs-esc-setup", privileged: true, inline: render_provision("ca01-esc/adcs-esc-setup.ps1")

    disable_internet_gateway(vm, "ca01-esc")
    add_health_check(vm, "ca01-esc")
  end
  end

  # ===========================================================================
  # WIN10
  # ===========================================================================
  if profile_includes?("win10")
  config.vm.define "win10" do |vm|
    vm.vm.box = "peru/windows-10-enterprise-x64-eval"
    vm.vm.hostname = "win10"
    vm.vm.synced_folder ".", "/vagrant", disabled: true
    # Use default timeouts for non-DC VMs
    configure_windows_comm(vm, "vagrant", "vagrant")
    
    domain_join_windows(vm, "WIN10", VM_IPS[:win10], VM_MEMORY[:win10], 30)

    vm.vm.provision "shell", name: "win10-config", privileged: true, inline: render_provision("win10/win10-config.ps1")

    disable_internet_gateway(vm, "win10")
    add_health_check(vm, "win10")
  end
  end

  # ===========================================================================
  # LINUX01
  # ===========================================================================
  if profile_includes?("linux01")
  config.vm.define "linux01" do |vm|
    vm.vm.box = "generic/ubuntu2204"
    vm.vm.box_version = "4.3.10"
    vm.vm.hostname = "linux01"

    configure_network(vm, VM_IPS[:linux01])

    configure_provider(vm, memory: VM_MEMORY[:linux01], cpus: VM_CPUS[:linux01])

    # Add SSH key for secure access
    vm.ssh.insert_key = true

    write_lab_hosts(vm)

    vm.vm.provision "shell", name: "linux01-config", inline: render_provision("linux01/linux01-config.sh")
  end
  end

  # ===========================================================================
  # PRINT01
  # ===========================================================================
  if profile_includes?("print01")
  config.vm.define "print01" do |vm|
    vm.vm.box = "peru/windows-server-2022-standard-x64-eval"
    vm.vm.hostname = "print01"
    vm.vm.synced_folder ".", "/vagrant", disabled: true
    # Use default timeouts for non-DC VMs
    configure_windows_comm(vm, "vagrant", "vagrant")
    
    domain_join_windows(vm, "PRINT01", VM_IPS[:print01], VM_MEMORY[:print01], 40)

    vm.vm.provision "shell", name: "printnightmare-config", privileged: true, inline: render_provision("print01/printnightmare-config.ps1")

    disable_internet_gateway(vm, "print01")
    add_health_check(vm, "print01")
  end
  end

  # ===========================================================================
  # LLM01 — OWASP Top 10 for LLM Applications (2025) training lab.
  # App lives in ./llm-lab; see llm-lab/README.md for full docs. The
  # provisioner below only stages files and runs setup — all vulnerable
  # behavior is sandboxed inside the app itself (llm-lab/app/safety.py).
  # ===========================================================================
  if profile_includes?("llm01")
  config.vm.define "llm01" do |vm|
    vm.vm.box = "generic/ubuntu2204"
    vm.vm.box_version = "4.3.10"
    vm.vm.hostname = "llm01"

    configure_network(vm, VM_IPS[:llm01])

    configure_provider(vm,
      memory: VM_MEMORY[:llm01],
      cpus: VM_CPUS[:llm01],
      disk_size: 100
    )

    vm.vm.synced_folder ".", "/vagrant", disabled: true
    vm.ssh.insert_key = true

    write_lab_hosts(vm)

    # The file provisioner runs as the unprivileged vagrant user, so the
    # app lands in a staging path first; the shell provisioner below moves
    # it into place under a dedicated, unprivileged service account.
    vm.vm.provision "file", source: "llm-lab", destination: "/tmp/llm-lab-src"

    vm.vm.provision "shell", name: "llm01-config", privileged: true, inline: render_provision("llm01/llm01-config.sh", LAB_SUBNET: LAB_SUBNET, LLM01_IP: VM_IPS[:llm01])
  end
  end

  # ===========================================================================
  # METASPLOITABLE2
  # ===========================================================================
  if profile_includes?("metasploitable2")
  config.vm.define "metasploitable2" do |vm|
    vm.vm.box = "deargle/metasploitable2"
    vm.vm.box_version = "0.1.0"
    vm.vm.hostname = "metasploitable2"
    
    configure_network(vm, VM_IPS[:metasploitable2])
    
    configure_provider(vm, memory: VM_MEMORY[:metasploitable2], cpus: VM_CPUS[:metasploitable2])
    
    vm.vm.synced_folder ".", "/vagrant", disabled: true
    vm.ssh.username = "msfadmin"
    vm.ssh.password = "msfadmin"
    vm.ssh.insert_key = false  # Metasploitable2 has known SSH key
    
    write_lab_hosts(vm)

    vm.vm.provision "shell", name: "metasploitable2-dns", run: "once", inline: render_provision("metasploitable2/dns-config.sh", DC_IP: DC_IP, DOMAIN_NAME: DOMAIN_NAME)
  end
  end

  # ===========================================================================
  # JUICE-SHOP
  # ===========================================================================
  if profile_includes?("juice-shop")
  config.vm.define "juice-shop" do |vm|
    vm.vm.box = "ubuntu/jammy64"
    vm.vm.box_version = "20241007.0.0"
    vm.vm.hostname = "juice-shop"
    
    configure_network(vm, VM_IPS[:juice_shop])

    configure_provider(vm, memory: VM_MEMORY[:juice_shop], cpus: VM_CPUS[:juice_shop])

    vm.ssh.insert_key = true

    write_lab_hosts(vm)
    
    vm.vm.provision "shell", name: "juice-shop-setup", run: "once", inline: render_provision("juice-shop/juice-shop-setup.sh")
  end
  end

  # ===========================================================================
  # CLOUD-PENTEST
  # ===========================================================================
  if profile_includes?("cloud-pentest")
  config.vm.define "cloud-pentest" do |vm|
    vm.vm.box = "generic/ubuntu2204"
    vm.vm.box_version = "4.3.10"
    vm.vm.hostname = "cloud-pentest"

    configure_network(vm, VM_IPS[:cloud_pentest])

    configure_provider(vm, memory: VM_MEMORY[:cloud_pentest], cpus: VM_CPUS[:cloud_pentest])

    vm.vm.synced_folder ".", "/vagrant", disabled: true
    vm.ssh.insert_key = true

    write_lab_hosts(vm)

    vm.vm.provision "shell", name: "cloud-pentest-config", inline: render_provision("cloud-pentest/cloud-pentest-config.sh")
  end
  end
end
