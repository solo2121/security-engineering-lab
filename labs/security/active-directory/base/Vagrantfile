# -*- mode: ruby -*-
# vi: set ft=ruby :

# ============================================================
# VAGRANT PENTEST / WINDOWS LAB – ENTERPRISE SECURITY TESTING ENVIRONMENT
# COMPLETE ACTIVE DIRECTORY ATTACK CHAIN SIMULATION WITH MODERN CLOUD VECTORS
# ============================================================

# ==============================================================================
# Author: Miguel A. Carlo
# Project: Enterprise Active Directory Penetration Testing Lab
# Version: 1.15 - Enterprise Edition (FLAT NETWORK - PROFILE-BASED)
# Release Date: unreleased
#
# UNIFIED VAGRANTFILE: this single file supports both KVM/QEMU via
# vagrant-libvirt and VirtualBox. Select a provider explicitly, e.g.:
#   vagrant up --provider=libvirt
#   vagrant up --provider=virtualbox
# or set VAGRANT_DEFAULT_PROVIDER. If neither is set, libvirt is used on
# Linux hosts and VirtualBox elsewhere (see current_provider below).
# Set LAB_GUI=true to run VirtualBox VMs with a GUI window (headless by
# default; no effect under libvirt).
#
# Changes in v1.15:
# - Split the Vagrantfile into vagrant/*.rb (constants, profiles, providers,
#   Windows and Linux helpers, one file per VM). The top-level statements run
#   in the same order as before, so the lab is configured identically. See
#   vagrant/README.md.
#
# Changes in v1.14:
# - Moved the inline PowerShell/shell provisioners into provision/ (see
#   render_provision below). The scripts sent to each guest are unchanged.
# - Added KALI_BOX / KALI_BOX_VERSION so the attacker VM can run an
#   alternate Debian-based pentesting distribution (e.g. Parrot
#   Security) instead of Kali Linux, without renaming the VM. Defaults
#   are unchanged (kalilinux/rolling).
#
# Changes in v1.13:
# - Added LAB_PROFILE (minimal/ad/web/cloud/full) to control which
#   optional VMs are created; "vagrant up" no longer always builds
#   all 11 VMs. Default profile is "ad" (kali, dc01, db01, ca01-esc,
#   win10, linux01). See README.md "Lab Profiles" section.
# - Removed the unenforced "RESTRICTED STARTUP PROFILE" banner.
# - juice-shop now calls write_lab_hosts for consistent /etc/hosts
#   entries, matching metasploitable2 and cloud-pentest.
#
# Changes in v1.12:
# - Fixed plugin check order to prevent false positives
# - Added proper error handling for missing config.rb
# - Fixed hostmanager aliases syntax
# - Fixed winrm configuration for all Windows VMs
# - Added validation for CPU/Memory values
# - Fixed variable interpolation in shell scripts
# - Added retry logic for DNS configuration
# - Fixed duplicate network configuration
# - Added proper SSH key handling for Linux VMs
# - Added winrm_timeout parameter to configure_windows_comm for DC01
# ==============================================================================

# ------------------------------------------------------------
# EXTERNAL CONFIGURATION (OPTIONAL)
# ------------------------------------------------------------
begin
  require_relative 'config.rb' if File.exist?('config.rb')
rescue LoadError => e
  puts "[WARN] config.rb not found or unable to load: #{e.message}"
rescue => e
  puts "[WARN] config.rb loaded with errors: #{e.message}"
end

# ------------------------------------------------------------
# LAB CODE (vagrant/) - loaded in this order; the order matters
# because each file may use constants defined by the ones before it.
# ------------------------------------------------------------
require_relative 'vagrant/provider_detect'  # PROVIDER, LAB_GUI
require_relative 'vagrant/constants'        # box, domain, VM_IPS / VM_MEMORY / VM_CPUS
require_relative 'vagrant/profiles'         # LAB_PROFILES and the active profile
require_relative 'vagrant/settings'         # passwords, DEBUG
require_relative 'vagrant/provision'        # provision/ loader and escaping helpers
require_relative 'vagrant/environment'      # env vars, validation, resource report
require_relative 'vagrant/providers'        # libvirt / VirtualBox and networking
require_relative 'vagrant/windows'          # Windows guest helpers
require_relative 'vagrant/linux'            # Linux guest helpers
require_relative 'vagrant/plugins'          # plugin checks
require_relative 'vagrant/machines/kali'
require_relative 'vagrant/machines/dc01'
require_relative 'vagrant/machines/db01'
require_relative 'vagrant/machines/ca01-esc'
require_relative 'vagrant/machines/win10'
require_relative 'vagrant/machines/linux01'
require_relative 'vagrant/machines/print01'
require_relative 'vagrant/machines/llm01'
require_relative 'vagrant/machines/metasploitable2'
require_relative 'vagrant/machines/juice-shop'
require_relative 'vagrant/machines/cloud-pentest'

# ============================================================
# VAGRANT MACHINES
# ============================================================
Vagrant.configure("2") do |config|
  configure_plugins(config)

  define_kali(config)
  define_dc01(config)
  define_db01(config) if profile_includes?("db01")
  define_ca01_esc(config) if profile_includes?("ca01-esc")
  define_win10(config) if profile_includes?("win10")
  define_linux01(config) if profile_includes?("linux01")
  define_print01(config) if profile_includes?("print01")
  define_llm01(config) if profile_includes?("llm01")
  define_metasploitable2(config) if profile_includes?("metasploitable2")
  define_juice_shop(config) if profile_includes?("juice-shop")
  define_cloud_pentest(config) if profile_includes?("cloud-pentest")
end
