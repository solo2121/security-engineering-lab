# Copy to .env and edit. Never commit .env.
# The secure API refuses to run until at least one valid key is configured.
# Entries are user:role:tenant:key, comma separated. Roles: viewer, admin.
# Generate each key with:  python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# Keys shorter than 16 characters, or containing CHANGE_ME, are ignored.
LLM_LAB_API_KEYS=alice:viewer:tenant-a:CHANGE_ME,root:admin:tenant-a:CHANGE_ME

# mock (default, offline, deterministic) or ollama (needs: docker compose --profile ollama up)
LLM_LAB_PROVIDER=mock
LLM_LAB_OLLAMA_MODEL=llama3.2:1b

# Limits for the secure API
LLM_LAB_SECURE_RATE_LIMIT=10
LLM_LAB_SECURE_RATE_WINDOW=60
LLM_LAB_SECURE_DAILY_TOKENS=20000
LLM_LAB_PROVIDER_TIMEOUT=20
