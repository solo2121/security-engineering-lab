            }
          ]
        }
        EOF
          awslocal s3api put-bucket-policy --bucket public-bucket --policy file:///opt/cloud-lab/public-bucket-policy.json

          echo "CREDENTIALS: AWS_ACCESS_KEY=AKIAIOSFODNN7EXAMPLE" > /opt/cloud-lab/s3-data/leaked_creds.txt
