        Restart=always
        User=root
        [Install]
        WantedBy=multi-user.target
        EOF

          cat > /etc/systemd/system/s3-enumerator.service << 'EOF'
        [Unit]
        Description=S3 Enumerator Service
        After=network.target
        [Service]
        ExecStart=/usr/bin/python3 /opt/cloud-lab/s3_enumerator.py
        Restart=always
        User=root
        [Install]
        WantedBy=multi-user.target
        EOF

          systemctl daemon-reload
          systemctl enable metadata-simulator s3-enumerator
          systemctl start metadata-simulator s3-enumerator

          echo "=== Creating Terraform state file with exposed secrets ==="
          mkdir -p /opt/cloud-lab/terraform
