def ensure_plugins(plugins)
  plugins.each do |plugin|
    unless Vagrant.has_plugin?(plugin)
      puts "Installing #{plugin} plugin..."
      system("vagrant plugin install #{plugin}") || raise("Failed to install #{plugin} plugin")
    end
  end
end

required_plugins = if PROVIDER == :libvirt
  ["vagrant-reload", "vagrant-libvirt", "vagrant-hostmanager"]
else
  ["vagrant-reload", "vagrant-hostmanager"]
end
ensure_plugins(required_plugins)

validate_host_requirements
ensure_provider_networks

puts "================================================================================"
puts "  ENTERPRISE AD PENETRATION TESTING LAB (#{PROVIDER.to_s.upcase})"
puts "================================================================================"
puts "  Profile: #{LAB_PROFILE} (#{PROFILES[LAB_PROFILE][:description]})"
puts "  VMs: #{PROFILES[LAB_PROFILE][:vms].join(', ')}"
total_memory = calculate_total_memory(LAB_PROFILE)
puts "  Total RAM: #{(total_memory/1024.0).round(1)}GB required"
puts "  Minimum RAM: #{PROFILES[LAB_PROFILE][:min_ram]/1024}GB"
puts "================================================================================"

# ==============================================================================
# HELPER FUNCTIONS - VIRTUALBOX
# ==============================================================================

def configure_vlan_network(vm, vlan_id, host_number, options = {})
  cfg = VLAN_CONFIG[vlan_id]
  guest_type = options[:guest] || :linux
  mac_addr = generate_vlan_mac(vlan_id, host_number)

  if PROVIDER == :libvirt
    nic_model = guest_type == :windows ? "e1000e" : "virtio"
    vm.vm.network :private_network,
      ip: vlan_ip(vlan_id, host_number),
      netmask: "255.255.255.0",
      libvirt__network_name: cfg[:name],
      libvirt__model_type: nic_model,
      libvirt__forward_mode: "none",
      libvirt__dhcp_enabled: false,
      auto_config: false,
      libvirt__mac: mac_addr
  else
    vm.vm.network "private_network",
      ip: vlan_ip(vlan_id, host_number),
      netmask: "255.255.255.0",
      virtualbox__intnet: cfg[:name],
      mac: mac_addr
  end
end

def configure_linux_network(vm, ip_address, gateway, dns_server)
  nat_ip_prefix = PROVIDER == :libvirt ? "192.168.121" : "10.0.2"
  vm.vm.provision "shell",
    name: "linux-network-config",
    run: "once",
    inline: <<-SHELL
#!/bin/bash
set -e

LOG_FILE="/var/log/lab-network.log"
mkdir -p /var/log/lab
exec 1> >(tee -a "$LOG_FILE") 2>&1

echo "$(date) - Configuring network for #{ip_address}"

# Wait for all interfaces to be enumerated
sleep 5

DEFAULT_IF=$(ip route show default 2>/dev/null | awk '{print $5}' | head -n 1)

# Find the interface that does NOT have the management IP (#{nat_ip_prefix}.x for the provider's NAT)
TARGET_IF=""
for iface in $(ip -o link show | awk -F': ' '{print $2}' | grep -v '^lo$'); do
  IF_IP=$(ip addr show "$iface" 2>/dev/null | grep -oP '(?<=inet\\s)\\d+(\\.\\d+){3}' | head -1)
  if [ -n "$IF_IP" ] && echo "$IF_IP" | grep -qv '#{nat_ip_prefix}'; then
    TARGET_IF="$iface"
    break
  fi
done

if [ -z "$TARGET_IF" ]; then
  TARGET_IF=$(ip -o link show | awk -F': ' '{print $2}' | grep -v -E "^lo|$DEFAULT_IF" | head -n 1)
fi
if [ -z "$TARGET_IF" ]; then
  TARGET_IF=$(ip -o link show | awk -F': ' '{print $2}' | grep -v '^lo$' | head -n 1)
fi

echo "Using interface: $TARGET_IF"

dhclient -r "$TARGET_IF" 2>/dev/null || true
pkill -9 dhclient 2>/dev/null || true

ip addr flush dev "$TARGET_IF" 2>/dev/null || true
ip route flush dev "$TARGET_IF" 2>/dev/null || true
ip addr add #{ip_address}/24 dev "$TARGET_IF"
ip link set "$TARGET_IF" up

if [ -n "#{gateway}" ]; then
  ip route add default via #{gateway} dev "$TARGET_IF" 2>/dev/null || true
fi

if [ -n "#{dns_server}" ]; then
  echo "nameserver #{dns_server}" > /etc/resolv.conf
  echo "search lab.local" >> /etc/resolv.conf
fi

echo "$(date) - Network configured: $TARGET_IF = #{ip_address}/24 gw=#{gateway}"
SHELL
end

def configure_windows_comm(vm, user = "vagrant", pass = "vagrant", 
                          boot_timeout = WINRM_BOOT_TIMEOUT_DEFAULT, 
                          winrm_timeout = WINRM_COMM_TIMEOUT_DEFAULT)
  vm.vm.communicator = "winrm"
  vm.vm.guest = :windows
  vm.vm.boot_timeout = boot_timeout

  vm.winrm.username = user
  vm.winrm.password = pass
  vm.winrm.transport = :plaintext
  vm.winrm.port = 5985
  vm.winrm.retry_limit = 240
  vm.winrm.retry_delay = 30
  vm.winrm.timeout = winrm_timeout
  vm.winrm.basic_auth_only = true
end

def configure_libvirt(vm, config)
  settings = VM_CONFIG[config[:name]] || {}

  vm.vm.provider :libvirt do |libvirt|
    libvirt.memory = config[:memory] || settings[:memory] || 1024
    libvirt.cpus = config[:cpus] || settings[:cpus] || 1
    libvirt.disk_bus = "virtio"
    libvirt.nic_model_type = config[:guest] == :windows ? "e1000e" : "virtio"
    libvirt.video_type = "vga"
    libvirt.video_vram = 16384
    # Group VMs cleanly under lab-vlan_ prefix in virsh
    libvirt.default_prefix = "lab-vlan"
    libvirt.nested = true
    libvirt.graphics_type = "vnc"
    libvirt.graphics_ip = "127.0.0.1"
    libvirt.video_accel3d = false
    libvirt.qemu_use_session = false
    libvirt.uri = 'qemu:///system'
    libvirt.mgmt_attach = true

    if config[:guest] == :windows
      libvirt.cpu_mode = "host-passthrough"
      libvirt.cpu_model = "host"
    end

    if config[:disk_size]
      libvirt.storage :file,
        size: "#{config[:disk_size]}G",
        type: "qcow2",
        bus: "virtio"
    end
  end
end

def configure_virtualbox(vm, config)
  settings = VM_CONFIG[config[:name]] || {}

  vm.vm.provider :virtualbox do |vb|
    vb.memory = config[:memory] || settings[:memory] || 1024
    vb.cpus = config[:cpus] || settings[:cpus] || 1
    vb.gui = LAB_GUI
    vb.linked_clone = true

    # Enable hardware virtualization for better performance
    vb.customize ["modifyvm", :id, "--vtxvpid", "on"]
    vb.customize ["modifyvm", :id, "--vtxux", "on"]
    vb.customize ["modifyvm", :id, "--hwvirtex", "on"]
    vb.customize ["modifyvm", :id, "--nestedpaging", "on"]
    vb.customize ["modifyvm", :id, "--largepages", "on"]

    # Network settings - use virtio for better performance
    vb.customize ["modifyvm", :id, "--nictype1", "virtio"]

    # Graphics settings for Windows
    if config[:guest] == :windows
      vb.customize ["modifyvm", :id, "--vram", "128"]
      vb.customize ["modifyvm", :id, "--graphicscontroller", "vboxsvga"]
      vb.customize ["modifyvm", :id, "--audio", "none"]
      vb.customize ["modifyvm", :id, "--usb", "on"]
      vb.customize ["modifyvm", :id, "--usbehci", "on"]
    end

    # Performance optimizations
    vb.customize ["modifyvm", :id, "--ioapic", "on"]
    vb.customize ["modifyvm", :id, "--rtcuseutc", "on"]

    # Network adapter order: NAT for internet, Internal for lab
    vb.customize ["modifyvm", :id, "--nic1", "nat"]

    # Storage
    if config[:disk_size]
      vb.customize ["storagectl", :id, "--name", "SATA Controller", "--add", "sata", "--controller", "IntelAHCI"]
    end
  end
end

def configure_provider(vm, config)
  PROVIDER == :libvirt ? configure_libvirt(vm, config) : configure_virtualbox(vm, config)
end

def wait_for_dc(vm, ip = DC_IP, max_attempts = 60)
  vm.vm.provision "shell",
    run: "once",
    inline: <<-SHELL
      $LogDir = "C:\\LabLogs"
      New-Item -ItemType Directory -Path $LogDir -Force -ErrorAction SilentlyContinue
      $LogFile = "$LogDir\\wait-for-dc.log"
      
      function Write-Log {
        param($Message)
        $Timestamp = Get-Date -Format "yyyy-MM-dd HH:mm:ss"
        Write-Host "$Timestamp - $Message"
        Add-Content -Path $LogFile -Value "$Timestamp - $Message"
      }
      
      $attempt = 0
      $maxAttempts = #{max_attempts}
      $dcIP = '#{ip}'
      
      Write-Log "Waiting for Domain Controller at $dcIP..."
      
      while ($attempt -lt $maxAttempts) {
        $attempt++
        if (Test-Connection $dcIP -Count 1 -Quiet) {
          try {
            if (Test-Path "\\\\$dcIP\\C$\\DC-FINAL.txt") {
              Write-Log "DC01 is fully configured."
              try {
                Test-WSMan $dcIP -ErrorAction SilentlyContinue | Out-Null
                Write-Log "WinRM is responding on DC01"
                exit 0
              } catch {
                Write-Log "DC reachable but WinRM not responding yet..."
              }
            } else {
              Write-Log "DC reachable but not fully configured yet..."
            }
          } catch {
            Write-Log "Could not access DC share: $_"
          }
        } else {
          Write-Log "DC not reachable yet (attempt $attempt of $maxAttempts)"
        }
        Start-Sleep -Seconds 30
      }
      Write-Log "ERROR: DC not ready after $maxAttempts attempts"
      exit 1
    SHELL
end

def domain_join_windows(vm, vm_name, dc_ip, gateway)
  vm.vm.provision "shell",
    name: "domain-join",
    privileged: true,
    reboot: "always",
    inline: <<-SHELL
      $LogDir = "C:\\LabLogs"
      New-Item -ItemType Directory -Path $LogDir -Force -ErrorAction SilentlyContinue
      $LogFile = "$LogDir\\domain-join-#{vm_name}.log"
      
      function Write-Log {
        param($Message)
        $Timestamp = Get-Date -Format "yyyy-MM-dd HH:mm:ss"
        Write-Host "$Timestamp - $Message"
        Add-Content -Path $LogFile -Value "$Timestamp - $Message"
      }
      
      Write-Log "Starting domain join for #{vm_name}"
      
      $maxRetries = 10
      $retryCount = 0
      $dnsSet = $false
      
      while ($retryCount -lt $maxRetries -and -not $dnsSet) {
        $retryCount++
        try {
          $adapter = Get-NetAdapter | Where-Object {$_.Status -eq 'Up'} | Select-Object -First 1
          if ($adapter) {
            Set-DnsClientServerAddress -InterfaceIndex $adapter.ifIndex -ServerAddresses '#{dc_ip}' -ErrorAction Stop
            $dnsSet = $true
            Write-Log "DNS set to #{dc_ip}"
          }
        } catch {
          Write-Log "DNS set attempt $retryCount failed, retrying..."
          Start-Sleep -Seconds 10
        }
      }
      
      if (-not $dnsSet) {
        Write-Log "ERROR: Failed to set DNS after $maxRetries attempts"
        exit 1
      }
      
      if (-not (Test-Connection '#{dc_ip}' -Count 1 -Quiet)) {
        Write-Log "ERROR: Cannot reach DC at #{dc_ip}"
        exit 1
      }
      
      $sec = ConvertTo-SecureString '#{ps_squote_escape(DOMAIN_JOIN_PASS)}' -AsPlainText -Force
      $cred = New-Object System.Management.Automation.PSCredential('#{DOMAIN_NETBIOS}\\#{DOMAIN_JOIN_USER}', $sec)
      
      $joinRetries = 5
      $joinCount = 0
      $joined = $false
      
      while ($joinCount -lt $joinRetries -and -not $joined) {
        $joinCount++
        try {
          Add-Computer -DomainName "#{DOMAIN_NAME}" -Credential $cred -Force -ErrorAction Stop
          $joined = $true
          Write-Log "Joined domain #{DOMAIN_NAME}"
        } catch {
          Write-Log "Domain join attempt $joinCount failed: $_"
          Start-Sleep -Seconds 30
        }
      }
      
      if (-not $joined) {
        Write-Log "ERROR: Failed to join domain after $joinRetries attempts"
        exit 1
      }
      
      if ($env:COMPUTERNAME -ne '#{vm_name}') {
        Rename-Computer -NewName '#{vm_name}' -Force
        Write-Log "Renamed computer to #{vm_name}"
      }
      
      Write-Log "SUCCESS: #{vm_name} domain join complete"
    SHELL
end

def disable_windows_defender(vm)
  vm.vm.provision "shell",
    name: "disable-defender",
    privileged: true,
    run: "once",
    inline: <<-POWERSHELL
      $LogDir = "C:\\LabLogs"
      New-Item -ItemType Directory -Path $LogDir -Force -ErrorAction SilentlyContinue
      $LogFile = "$LogDir\\disable-defender.log"
      
      function Write-Log {
        param($Message)
        $Timestamp = Get-Date -Format "yyyy-MM-dd HH:mm:ss"
        Write-Host "$Timestamp - $Message"
        Add-Content -Path $LogFile -Value "$Timestamp - $Message"
      }
      
      Write-Log "Configuring Windows Defender"
      
      New-Item -Path "HKLM:\\SOFTWARE\\Policies\\Microsoft\\Windows Defender" -Force -ErrorAction SilentlyContinue | Out-Null
      New-Item -Path "HKLM:\\SOFTWARE\\Policies\\Microsoft\\Windows Defender\\Real-Time Protection" -Force -ErrorAction SilentlyContinue | Out-Null
      
      Set-ItemProperty -Path "HKLM:\\SOFTWARE\\Policies\\Microsoft\\Windows Defender" -Name "DisableAntiSpyware" -Value 1 -Type DWord -Force -ErrorAction SilentlyContinue
      Set-ItemProperty -Path "HKLM:\\SOFTWARE\\Policies\\Microsoft\\Windows Defender\\Real-Time Protection" -Name "DisableRealtimeMonitoring" -Value 1 -Type DWord -Force -ErrorAction SilentlyContinue
      Set-ItemProperty -Path "HKLM:\\SOFTWARE\\Policies\\Microsoft\\Windows Defender\\Real-Time Protection" -Name "DisableBehaviorMonitoring" -Value 1 -Type DWord -Force -ErrorAction SilentlyContinue
      Set-ItemProperty -Path "HKLM:\\SOFTWARE\\Policies\\Microsoft\\Windows Defender\\Real-Time Protection" -Name "DisableOnAccessProtection" -Value 1 -Type DWord -Force -ErrorAction SilentlyContinue
      
      Set-ItemProperty -Path "HKLM:\\SYSTEM\\CurrentControlSet\\Services\\WinDefend" -Name "Start" -Value 4 -Type DWord -Force -ErrorAction SilentlyContinue
      
      Stop-Service WinDefend -Force -ErrorAction SilentlyContinue
      Write-Log "Windows Defender disabled"
    POWERSHELL
end

def configure_windows_static_ip(vm, ip, gateway)
  adapter_detect_ps = if PROVIDER == :libvirt
    <<-PS.chomp
      # Method 3: Ethernet 1
      $adapter = Get-NetAdapter -Name "Ethernet 1" -ErrorAction SilentlyContinue
      if ($adapter) { Write-Log "Found adapter by name: Ethernet 1" }

      # Method 4: Any non-NAT adapter
      if (-not $adapter) {
        $natIp = Get-NetIPAddress -IPAddress 192.168.121.* -ErrorAction SilentlyContinue | Select-Object -First 1
        if ($natIp) {
          $natAdapter = Get-NetAdapter -InterfaceIndex $natIp.InterfaceIndex -ErrorAction SilentlyContinue
          Write-Log "NAT/management adapter: $($natAdapter.Name) (192.168.121.x)"
          $adapter = Get-NetAdapter -ErrorAction SilentlyContinue |
                     Where-Object { $_.Status -eq 'Up' -and $_.Name -ne $natAdapter.Name -and $_.Name -notlike "*Loopback*" } |
                     Select-Object -First 1
          if ($adapter) { Write-Log "Found non-NAT adapter: $($adapter.Name)" }
        }
      }
    PS
  else
    <<-PS.chomp
      # Method 3: Ethernet 2 (VirtualBox internal network)
      if (-not $adapter) {
        $adapter = Get-NetAdapter -Name "Ethernet 2" -ErrorAction SilentlyContinue
        if ($adapter) { Write-Log "Found adapter by name: Ethernet 2" }
      }

      # Method 4: Ethernet (VirtualBox NAT)
      if (-not $adapter) {
        $adapter = Get-NetAdapter -Name "Ethernet" -ErrorAction SilentlyContinue
        if ($adapter) { Write-Log "Found adapter by name: Ethernet" }
      }

      # Method 5: Any non-NAT adapter
      if (-not $adapter) {
        $natIp = Get-NetIPAddress -IPAddress 10.0.2.* -ErrorAction SilentlyContinue | Select-Object -First 1
        if ($natIp) {
          $natAdapter = Get-NetAdapter -InterfaceIndex $natIp.InterfaceIndex -ErrorAction SilentlyContinue
          Write-Log "NAT adapter: $($natAdapter.Name) (10.0.2.x)"
          $adapter = Get-NetAdapter -ErrorAction SilentlyContinue |
                     Where-Object { $_.Status -eq 'Up' -and $_.Name -ne $natAdapter.Name -and $_.Name -notlike "*Loopback*" } |
                     Select-Object -First 1
          if ($adapter) { Write-Log "Found non-NAT adapter: $($adapter.Name)" }
        }
      }
    PS
  end

  vm.vm.provision "shell",
    name: "static-ip",
    privileged: true,
    run: "once",
    inline: <<-SHELL
      $LogDir = "C:\\LabLogs"
      New-Item -ItemType Directory -Path $LogDir -Force -ErrorAction SilentlyContinue
      $LogFile = "$LogDir\\static-ip.log"
      
      function Write-Log {
        param($Message)
        $Timestamp = Get-Date -Format "yyyy-MM-dd HH:mm:ss"
        Write-Host "$Timestamp - $Message"
        Add-Content -Path $LogFile -Value "$Timestamp - $Message"
      }
      
      Write-Log "Configuring static IP: #{ip} (gateway: #{gateway})"
      
      Write-Log "Waiting 60 seconds for network initialization..."
      Start-Sleep -Seconds 60
      
      Write-Log "Searching for correct network adapter..."
      $adapter = $null
      
      # Method 1: Target IP
      $adapter = Get-NetIPAddress -AddressFamily IPv4 -ErrorAction SilentlyContinue | 
                 Where-Object { $_.IPAddress -eq '#{ip}' } | 
                 ForEach-Object { Get-NetAdapter -InterfaceIndex $_.InterfaceIndex -ErrorAction SilentlyContinue }
      
      # Method 2: Lab subnet
      if (-not $adapter) {
        $adapter = Get-NetIPAddress -AddressFamily IPv4 -ErrorAction SilentlyContinue | 
                   Where-Object { $_.IPAddress -like '172.28.*' } | 
                   ForEach-Object { Get-NetAdapter -InterfaceIndex $_.InterfaceIndex -ErrorAction SilentlyContinue } |
                   Select-Object -First 1
        if ($adapter) { Write-Log "Found adapter on lab subnet: $($adapter.Name)" }
      }
      
      #{adapter_detect_ps}
      
      # Method 6: Last resort
      if (-not $adapter) {
        $adapter = Get-NetAdapter | 
                   Where-Object {$_.Status -eq 'Up' -and $_.Name -notlike "*Loopback*"} | 
                   Select-Object -First 1
        if ($adapter) { Write-Log "WARNING: Using first available adapter: $($adapter.Name)" }
      }
      
      if (-not $adapter) {
        Write-Log "ERROR: No suitable network adapter found"
        exit 1
      }
      
      Write-Log "Using adapter: $($adapter.Name) (Index: $($adapter.ifIndex))"
      
      # Remove existing configuration
      Get-NetIPAddress -InterfaceIndex $adapter.ifIndex -AddressFamily IPv4 -ErrorAction SilentlyContinue | Remove-NetIPAddress -Confirm:$false -ErrorAction SilentlyContinue
      Get-NetRoute -InterfaceIndex $adapter.ifIndex -DestinationPrefix "0.0.0.0/0" -ErrorAction SilentlyContinue | Remove-NetRoute -Confirm:$false -ErrorAction SilentlyContinue
      
      # Disable Duplicate Address Detection
      Set-NetIPInterface -InterfaceIndex $adapter.ifIndex -DadTransmits 0 -ErrorAction SilentlyContinue
      Write-Log "Disabled Duplicate Address Detection"
      
      # Set static IP with SkipAsSource=$false
      New-NetIPAddress -InterfaceIndex $adapter.ifIndex -IPAddress #{ip} -PrefixLength 24 -SkipAsSource $false -ErrorAction SilentlyContinue
      Write-Log "Set static IP: #{ip}"
      
      # Add real VLAN gateway (OPNsense)
      New-NetRoute -InterfaceIndex $adapter.ifIndex -DestinationPrefix "0.0.0.0/0" -NextHop #{gateway} -ErrorAction SilentlyContinue
      Write-Log "Added gateway: #{gateway}"
      
      # Set DNS
      Set-DnsClientServerAddress -InterfaceIndex $adapter.ifIndex -ServerAddresses #{DC_IP}
      Write-Log "Set DNS to DC01 (#{DC_IP})"
      
      # Set network to Private
      try {
        Get-NetConnectionProfile | Set-NetConnectionProfile -NetworkCategory Private -ErrorAction SilentlyContinue
      } catch {
        Write-Log "Network category already set (domain-joined)"
      }
      
      # Disable firewall
      Set-NetFirewallProfile -Profile Domain,Public,Private -Enabled False
      Write-Log "Windows Firewall disabled"
      
      # Ensure WinRM
      Set-Service WinRM -StartupType Automatic
      Start-Service WinRM
      winrm set winrm/config/service '@{AllowUnencrypted="true"}'
      winrm set winrm/config/service/auth '@{Basic="true"}'
      
      Write-Log "STATIC IP CONFIGURATION COMPLETE"
    SHELL
end

def disable_internet_gateway(vm, vm_name)
  nat_ip_prefix = PROVIDER == :libvirt ? "192.168.121.*" : "10.0.2.*"
  vm.vm.provision "shell",
    name: "disable-mgmt-gateway-#{vm_name}",
    privileged: true,
    run: "once",
    inline: <<-SHELL
      $ErrorActionPreference = 'Continue'
      Write-Host "=============================================="
      Write-Host "DISABLING MANAGEMENT GATEWAY - #{vm_name.upcase}"
      Write-Host "=============================================="

      Start-Sleep -Seconds 30

      $natAdapter = Get-NetAdapter | Where-Object {
        $_.Status -eq 'Up' -and (
          (Get-NetIPAddress -InterfaceIndex $_.ifIndex -ErrorAction SilentlyContinue |
           Where-Object { $_.IPAddress -like "#{nat_ip_prefix}" })
        )
      } | Select-Object -First 1

      if ($natAdapter) {
        $route = Get-NetRoute -InterfaceIndex $natAdapter.ifIndex -DestinationPrefix "0.0.0.0/0" -ErrorAction SilentlyContinue
        if ($route) {
          Remove-NetRoute -InterfaceIndex $natAdapter.ifIndex -DestinationPrefix "0.0.0.0/0" -Confirm:$false -ErrorAction SilentlyContinue
          Write-Host "[OK] Management default gateway removed — VLAN gateway retained"
        } else {
          Write-Host "[INFO] No default gateway on management adapter"
        }
      } else {
        Write-Host "[INFO] No management adapter found — VM may already be isolated"
      }
      Write-Host "=============================================="
    SHELL
end

# ==============================================================================
# LAB HOSTS FILE HELPER - Centralized /etc/hosts management
# ==============================================================================
def write_lab_hosts(vm)
  vm.vm.provision "shell",
    name: "configure-lab-hosts",
    privileged: true,
    run: "once",
    inline: <<-SHELL
      sed -i '/172\\.28\\./d' /etc/hosts
      cat <<EOF >> /etc/hosts
# --- Lab VMs (VLAN IP scheme) ---
172.28.99.10  kali.lab.local        kali
172.28.10.21  dc01.lab.local        dc01
172.28.10.23  db01.lab.local        db01
172.28.10.25  ca01-esc.lab.local    ca01-esc
172.28.20.30  win10.lab.local       win10
172.28.30.60  llm01.lab.local       llm01
172.28.30.72  linux01.lab.local     linux01
172.28.30.73  print01.lab.local     print01
172.28.30.80  cloud-pentest.lab.local cloud-pentest
172.28.40.12  metasploitable2.lab.local metasploitable2
172.28.40.15  juice-shop.lab.local  juice-shop
EOF
    SHELL
end

# ==============================================================================
# VAGRANT CONFIGURATION
# ==============================================================================
Vagrant.configure("2") do |config|
  config.vm.box_check_update = false
  
  if Vagrant.has_plugin?("vagrant-hostmanager")
    config.hostmanager.enabled = true
    config.hostmanager.manage_host = true
    config.hostmanager.manage_guest = true
    config.hostmanager.include_offline = true
    config.hostmanager.aliases = {
      "DC01" => ["dc01.lab.local", "dc01"],
      "DB01" => ["db01.lab.local", "db01"],
      "CA01-ESC" => ["ca01-esc.lab.local", "ca01-esc"],
      "WIN10" => ["win10.lab.local", "win10"],
      "llm01" => ["llm01.lab.local", "llm01"],
      "linux01" => ["linux01.lab.local", "linux01"],
      "print01" => ["print01.lab.local", "print01"],
      "cloud-pentest" => ["cloud-pentest.lab.local", "cloud-pentest"],
      "metasploitable2" => ["metasploitable2.lab.local", "metasploitable2"],
      "juice-shop" => ["juice-shop.lab.local", "juice-shop"],
      "kali" => ["kali.lab.local", "kali"]
    }
  end

  vms_to_start = PROFILES[LAB_PROFILE][:vms]
  
  vms_to_start.each do |vm_name|
    vm_config = VM_CONFIG[vm_name]
    next unless vm_config
    
    config.vm.define vm_name, primary: vm_config[:primary] || false, autostart: vm_config[:autostart] || true do |vm|
      
      vm.vm.box = vm_config[:box]
      vm.vm.box_version = vm_config[:box_version] if vm_config[:box_version] && vm_config[:box_version] != 'latest'
      vm.vm.hostname = vm_config[:hostname]
      vm.vm.synced_folder ".", "/vagrant", disabled: true
      
      if vm_config[:guest] == :windows
        if vm_name == 'DC01'
          configure_windows_comm(vm, "vagrant", "vagrant", WINRM_BOOT_TIMEOUT_DC, WINRM_COMM_TIMEOUT_DC)
        else
          configure_windows_comm(vm, "vagrant", "vagrant")
        end
      end
      
      if vm_config[:ssh_username]
        vm.ssh.username = vm_config[:ssh_username]
        vm.ssh.password = vm_config[:ssh_password] if vm_config[:ssh_password]
        vm.ssh.insert_key = true 
      else
        vm.ssh.insert_key = true if vm_config[:guest] == :linux
      end
      
      configure_provider(vm, vm_config)
      
      # ============================================================
      # NETWORK CONFIGURATION - VIRTUALBOX
      # ============================================================
      if vm_name == 'opnsense'
        # WAN network for OPNsense (Internal network)
        vm.vm.network "private_network",
          ip: "192.168.100.2",
          netmask: "255.255.255.0",
          virtualbox__intnet: "vlan-wan",
          mac: "08:00:27:00:00:01"
        
        # VLAN bridges for each VLAN
        [10, 20, 30, 40, 99].each_with_index do |vlan_id, idx|
          vm.vm.network "private_network",
            ip: VLAN_CONFIG[vlan_id][:gateway],
            netmask: "255.255.255.0",
            virtualbox__intnet: VLAN_CONFIG[vlan_id][:name],
            mac: "08:00:27:%02x:%02x:%02x" % [vlan_id & 0xff, ((idx+2) >> 8) & 0xff, (idx+2) & 0xff]
        end
        
      elsif vm_config[:nat_ip]
        # VMs with NAT IP (Kali)
        vm.vm.network "private_network",
          ip: vm_config[:nat_ip],
          netmask: "255.255.255.0",
          virtualbox__intnet: "vlan-wan",
          mac: "08:00:27:00:00:02"
        
        configure_vlan_network(vm, vm_config[:vlan], vm_config[:host_number], guest: vm_config[:guest])
        
      else
        configure_vlan_network(vm, vm_config[:vlan], vm_config[:host_number], guest: vm_config[:guest])
      end
      
      vlan_id = vm_config[:vlan]
      host_number = vm_config[:host_number]
      vm_ip = vlan_ip(vlan_id, host_number) rescue nil
      gateway = VLAN_CONFIG[vlan_id][:gateway] rescue nil
      dns_server = vlan_ip(10, 21) rescue DC_IP
      
      if vm_config[:guest] == :windows
        configure_windows_static_ip(vm, vm_ip, gateway) if vm_ip
        disable_windows_defender(vm)
        
        unless ['opnsense'].include?(vm_name)
          wait_for_dc(vm, DC_IP)
          domain_join_windows(vm, vm_name, DC_IP, gateway) if vm_ip
        end
        
      elsif vm_config[:guest] == :linux
        # OPNsense is FreeBSD-based: no /bin/bash, iproute2, or dhclient.
        # Its interfaces are configured via the opnsense-init provisioner (config.xml),
        # so the Linux network-config provisioner must be skipped here to avoid
        # "bad interpreter: /bin/bash: No such file or directory".
        configure_linux_network(vm, vm_ip, gateway, dns_server) if vm_ip && vm_name != 'opnsense'
        # FIX: All Linux VMs should get lab hosts entries
        write_lab_hosts(vm) unless vm_name == 'opnsense'
      end
      
      # ============================================================
      # VM-SPECIFIC PROVISIONING - PRESERVED FROM ORIGINAL
      # ============================================================
      case vm_name
      when 'opnsense'
        vm.vm.boot_timeout = 1200

        opnsense_iface_comment = if PROVIDER == :libvirt
          "            # Interface mapping shifted by 1 to account for management NIC (vtnet0).\n" \
          "            # With mgmt_attach=true:\n" \
          "            #   vtnet0 = management (192.168.121.x — Vagrant)\n" \
          "            #   vtnet1 = WAN    (192.168.100.2)\n" \
          "            #   vtnet2 = LAN    (172.28.10.1  — VLAN 10)\n" \
          "            #   vtnet3 = OPT1   (172.28.20.1  — VLAN 20)\n" \
          "            #   vtnet4 = OPT2   (172.28.30.1  — VLAN 30)\n" \
          "            #   vtnet5 = OPT3   (172.28.40.1  — VLAN 40)\n" \
          "            #   vtnet6 = OPT4   (172.28.99.1  — VLAN 99)"
        else
          "            # VirtualBox network interfaces:\n" \
          "            #   vtnet0 = NAT (management - 10.0.2.15)\n" \
          "            #   vtnet1 = WAN    (192.168.100.2)\n" \
          "            #   vtnet2 = LAN    (172.28.10.1  — VLAN 10)\n" \
          "            #   vtnet3 = OPT1   (172.28.20.1  — VLAN 20)\n" \
          "            #   vtnet4 = OPT2   (172.28.30.1  — VLAN 30)\n" \
          "            #   vtnet5 = OPT3   (172.28.40.1  — VLAN 40)\n" \
          "            #   vtnet6 = OPT4   (172.28.99.1  — VLAN 99)"
        end

        vm.vm.provision "shell",
          name: "opnsense-init",
          run: "once",
          inline: <<-SHELL
            #!/bin/sh
            echo "================================================================================"
            echo "OPNSENSE INITIAL CONFIGURATION (#{PROVIDER.to_s.upcase})"
            echo "================================================================================"
            
            sleep 60
            
            #{opnsense_iface_comment}
            cat > /conf/config.xml <<'EOF'
            <?xml version="1.0"?>
            <opnsense>
              <version>24.7</version>
              <system>
                <hostname>opnsense</hostname>
                <domain>lab.local</domain>
                <group>
                  <name>admins</name>
                  <description>System Administrators</description>
                  <scope>system</scope>
                  <gid>1999</gid>
                  <member>0</member>
                  <priv>page-all</priv>
                </group>
                <user>
                  <name>root</name>
                  <descr>System Administrator</descr>
                  <scope>system</scope>
                  <groupname>admins</groupname>
                  <password>$2y$10$nHvwHs9PtSI9QiAujjP8Mu7Bpk.Hl1xOKlYIetxdj5yuIj/J98BXu</password>
                  <uid>0</uid>
                </user>
                <timezone>UTC</timezone>
                <webgui>
                  <protocol>http</protocol>
                  <port>80</port>
                  <disable_redirect>1</disable_redirect>
                </webgui>
                <ssh>
                  <enabled>1</enabled>
                  <port>22</port>
                  <permitrootlogin>1</permitrootlogin>
                  <passwordauth>1</passwordauth>
                </ssh>
              </system>
              <interfaces>
                <wan><if>vtnet1</if><enable>1</enable><ipaddr>192.168.100.2</ipaddr><subnet>24</subnet><gateway>192.168.100.1</gateway><descr>WAN</descr><blockpriv>0</blockpriv><blockbogons>0</blockbogons></wan>
                <lan><if>vtnet2</if><enable>1</enable><ipaddr>172.28.10.1</ipaddr><subnet>24</subnet><descr>Management VLAN</descr><blockpriv>0</blockpriv><blockbogons>0</blockbogons></lan>
                <opt1><if>vtnet3</if><enable>1</enable><ipaddr>172.28.20.1</ipaddr><subnet>24</subnet><descr>Workstations VLAN</descr><blockpriv>0</blockpriv><blockbogons>0</blockbogons></opt1>
                <opt2><if>vtnet4</if><enable>1</enable><ipaddr>172.28.30.1</ipaddr><subnet>24</subnet><descr>Servers VLAN</descr><blockpriv>0</blockpriv><blockbogons>0</blockbogons></opt2>
                <opt3><if>vtnet5</if><enable>1</enable><ipaddr>172.28.40.1</ipaddr><subnet>24</subnet><descr>DMZ VLAN</descr><blockpriv>0</blockpriv><blockbogons>0</blockbogons></opt3>
                <opt4><if>vtnet6</if><enable>1</enable><ipaddr>172.28.99.1</ipaddr><subnet>24</subnet><descr>Attacker VLAN</descr><blockpriv>0</blockpriv><blockbogons>0</blockbogons></opt4>
                <!-- vtnet0 is vagrant-libvirt's implicit management NIC (192.168.121.0/24 by
                     default), attached to every VM automatically in addition to the interfaces
                     declared in the Vagrantfile. It carries no lab traffic and is not part of
                     the WAN/LAN/VLAN topology. Left unassigned here, OPNsense drops it on
                     configctl interface reconfigure, which breaks Vagrant's SSH reconnection
                     after the post-init reboot. Assigning it DHCP (with no gateway entry below,
                     so it cannot become the default route) keeps it reachable for Vagrant only. -->
                <opt5><if>vtnet0</if><enable>1</enable><ipaddr>dhcp</ipaddr><descr>Vagrant Management (do not use for lab traffic)</descr><blockpriv>0</blockpriv><blockbogons>0</blockbogons></opt5>
              </interfaces>
              <gateways>
                <gateway_item><interface>wan</interface><gateway>192.168.100.1</gateway><name>WAN_GW</name><weight>1</weight><ipprotocol>inet</ipprotocol><descr>Default Gateway</descr></gateway_item>
              </gateways>
              <dhcpd>
                <lan><enable>1</enable><range><from>172.28.10.100</from><to>172.28.10.200</to></range><domain>lab.local</domain><dnsserver>172.28.10.21</dnsserver><gateway>172.28.10.1</gateway><subnet>255.255.255.0</subnet><defaultleasetime>86400</defaultleasetime><maxleasetime>172800</maxleasetime></lan>
                <opt1><enable>1</enable><range><from>172.28.20.100</from><to>172.28.20.200</to></range><domain>lab.local</domain><dnsserver>172.28.10.21</dnsserver><gateway>172.28.20.1</gateway><subnet>255.255.255.0</subnet><defaultleasetime>86400</defaultleasetime><maxleasetime>172800</maxleasetime></opt1>
                <opt2><enable>1</enable><range><from>172.28.30.100</from><to>172.28.30.200</to></range><domain>lab.local</domain><dnsserver>172.28.10.21</dnsserver><gateway>172.28.30.1</gateway><subnet>255.255.255.0</subnet><defaultleasetime>86400</defaultleasetime><maxleasetime>172800</maxleasetime></opt2>
                <opt3><enable>1</enable><range><from>172.28.40.100</from><to>172.28.40.200</to></range><domain>lab.local</domain><dnsserver>172.28.10.21</dnsserver><gateway>172.28.40.1</gateway><subnet>255.255.255.0</subnet><defaultleasetime>86400</defaultleasetime><maxleasetime>172800</maxleasetime></opt3>
                <opt4><enable>1</enable><range><from>172.28.99.100</from><to>172.28.99.200</to></range><domain>lab.local</domain><dnsserver>172.28.10.21</dnsserver><gateway>172.28.99.1</gateway><subnet>255.255.255.0</subnet><defaultleasetime>86400</defaultleasetime><maxleasetime>172800</maxleasetime></opt4>
              </dhcpd>
              <filter>
                <rule><type>pass</type><interface>wan</interface><ipprotocol>inet</ipprotocol><protocol>any</protocol><source><network>any</network></source><destination><any></any></destination><descr>Allow all OUT on WAN</descr></rule>
                <rule><type>pass</type><interface>lan</interface><ipprotocol>inet</ipprotocol><protocol>any</protocol><source><network>lan</network></source><destination><any></any></destination><descr>Allow LAN to any</descr></rule>
                <rule><type>pass</type><interface>opt1</interface><ipprotocol>inet</ipprotocol><protocol>any</protocol><source><network>opt1</network></source><destination><any></any></destination><descr>Allow Workstations to any</descr></rule>
                <rule><type>pass</type><interface>opt2</interface><ipprotocol>inet</ipprotocol><protocol>any</protocol><source><network>opt2</network></source><destination><any></any></destination><descr>Allow Servers to any</descr></rule>
                <rule><type>pass</type><interface>opt3</interface><ipprotocol>inet</ipprotocol><protocol>any</protocol><source><network>opt3</network></source><destination><any></any></destination><descr>Allow DMZ to any</descr></rule>
                <rule><type>pass</type><interface>opt4</interface><ipprotocol>inet</ipprotocol><protocol>udp</protocol><source><network>opt4</network></source><destination><address>172.28.10.21</address><port>53</port></destination><descr>Allow DNS to DC01</descr></rule>
                <rule><type>pass</type><interface>opt4</interface><ipprotocol>inet</ipprotocol><protocol>tcp</protocol><source><network>opt4</network></source><destination><address>172.28.10.21</address><port>53</port></destination><descr>Allow DNS to DC01</descr></rule>
                <rule><type>pass</type><interface>opt4</interface><ipprotocol>inet</ipprotocol><protocol>tcp</protocol><source><network>opt4</network></source><destination><address>172.28.10.21</address><port>88</port></destination><descr>Allow Kerberos TCP</descr></rule>
                <rule><type>pass</type><interface>opt4</interface><ipprotocol>inet</ipprotocol><protocol>udp</protocol><source><network>opt4</network></source><destination><address>172.28.10.21</address><port>88</port></destination><descr>Allow Kerberos UDP</descr></rule>
                <rule><type>pass</type><interface>opt4</interface><ipprotocol>inet</ipprotocol><protocol>tcp</protocol><source><network>opt4</network></source><destination><address>172.28.10.21</address><port>135</port></destination><descr>Allow RPC</descr></rule>
                <rule><type>pass</type><interface>opt4</interface><ipprotocol>inet</ipprotocol><protocol>tcp</protocol><source><network>opt4</network></source><destination><address>172.28.10.21</address><port>139</port></destination><descr>Allow NetBIOS</descr></rule>
                <rule><type>pass</type><interface>opt4</interface><ipprotocol>inet</ipprotocol><protocol>tcp</protocol><source><network>opt4</network></source><destination><address>172.28.10.21</address><port>445</port></destination><descr>Allow SMB</descr></rule>
                <rule><type>pass</type><interface>opt4</interface><ipprotocol>inet</ipprotocol><protocol>tcp</protocol><source><network>opt4</network></source><destination><address>172.28.10.21</address><port>389</port></destination><descr>Allow LDAP</descr></rule>
                <rule><type>pass</type><interface>opt4</interface><ipprotocol>inet</ipprotocol><protocol>udp</protocol><source><network>opt4</network></source><destination><address>172.28.10.21</address><port>389</port></destination><descr>Allow LDAP</descr></rule>
                <rule><type>pass</type><interface>opt4</interface><ipprotocol>inet</ipprotocol><protocol>tcp</protocol><source><network>opt4</network></source><destination><address>172.28.10.21</address><port>464</port></destination><descr>Allow Kerberos Password Change</descr></rule>
                <rule><type>pass</type><interface>opt4</interface><ipprotocol>inet</ipprotocol><protocol>tcp</protocol><source><network>opt4</network></source><destination><address>172.28.10.21</address><port>5985</port></destination><descr>Allow WinRM</descr></rule>
                <rule><type>pass</type><interface>opt4</interface><ipprotocol>inet</ipprotocol><protocol>icmp</protocol><source><network>opt4</network></source><destination><any></any></destination><descr>Allow ICMP</descr></rule>
              </filter>
            </opnsense>
#{'EOF'}
            
            chown root:wheel /conf/config.xml
            chmod 600 /conf/config.xml
            
            /usr/local/sbin/configctl interface reconfigure
            /usr/local/sbin/configctl dhcpd restart
            /usr/local/sbin/configctl filter reload
            /usr/local/sbin/configctl webgui restart
            /usr/local/sbin/configctl openssh restart
          SHELL
        
        vm.vm.provision :reload, name: "opnsense-reload-1"
        
        vm.vm.provision "shell",
          name: "opnsense-verify",
          run: "once",
          inline: <<-SHELL
            #!/bin/sh
            sleep 60
            /usr/local/sbin/configctl interface reconfigure
            /usr/local/sbin/configctl dhcpd restart
