          chmod +x /opt/cloud-lab/metadata_simulator.py
          pip3 install flask
          python3 /opt/cloud-lab/metadata_simulator.py &

          cat > /opt/cloud-lab/s3_enumerator.py << 'EOF'
        #!/usr/bin/env python3
        from flask import Flask, jsonify, request
        import subprocess
        app = Flask(__name__)

        @app.route('/list-buckets', methods=['GET'])
        def list_buckets():
            result = subprocess.getoutput("awslocal s3 ls")
            return jsonify({"buckets": result.split("\\n")})

        @app.route('/read-object', methods=['GET'])
        def read_object():
            bucket = request.args.get('bucket', '')
            key = request.args.get('key', '')
            result = subprocess.getoutput(f"awslocal s3 cp s3://{bucket}/{key} -")
            return jsonify({"content": result})

        @app.route('/public-bucket-check', methods=['GET'])
        def check_public():
            buckets = ["public-bucket", "internal-docs", "backup-data"]
            results = {}
            for bucket in buckets:
                policy = subprocess.getoutput(f"awslocal s3api get-bucket-policy --bucket {bucket} 2>/dev/null")
                results[bucket] = "PUBLIC" if "Principal" in policy and "*" in policy else "PRIVATE"
            return jsonify(results)

        @app.route('/list-secrets', methods=['GET'])
        def list_secrets():
            result = subprocess.getoutput("awslocal secretsmanager list-secrets")
            return jsonify({"secrets": result})

        @app.route('/list-functions', methods=['GET'])
        def list_functions():
            result = subprocess.getoutput("awslocal lambda list-functions")
            return jsonify({"functions": result})
        EOF
          chmod +x /opt/cloud-lab/s3_enumerator.py
          python3 /opt/cloud-lab/s3_enumerator.py &
          
          cat > /etc/systemd/system/metadata-simulator.service << 'EOF'
