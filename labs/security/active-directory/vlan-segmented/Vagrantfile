# ==============================================================================
# ENTERPRISE SECURITY TESTING ENVIRONMENT
# ACTIVE DIRECTORY ATTACK CHAIN SIMULATION LAB
# CLOUD, DEVSECOPS, AND LLM SECURITY ASSESSMENT PLATFORM
# ENTERPRISE VLAN SEGMENTATION (VIRTUALBOX)
# ==============================================================================

# Author      : Miguel A. Carlo
# Project     : Enterprise Active Directory Penetration Testing Lab (VLAN Edition)
# Version     : 2.1.6 - Unified Edition (KVM/libvirt + VirtualBox)
# Updated     : 2026-11-27
#
# UNIFIED VAGRANTFILE: this single file supports both KVM/QEMU via
# vagrant-libvirt and VirtualBox. Select a provider explicitly, e.g.:
#   vagrant up --provider=libvirt
#   vagrant up --provider=virtualbox
# or set VAGRANT_DEFAULT_PROVIDER. If neither is set, libvirt is used on
# Linux hosts and VirtualBox elsewhere (see current_provider below).
#
# This file was consolidated from two previously-diverged Vagrantfiles
# (a libvirt-only Vagrantfile and this VirtualBox-only Vagrantfile). The
# VirtualBox variant had accumulated lab content the libvirt variant
# never received (a fuller LLM01 OWASP Top-10 module and a Terraform
# state-file secrets-exposure scenario for cloud-pentest, plus an LDIF-
# based AD CS template-creation technique in place of `certutil -setreg`).
# That fuller content is now what both providers run.
#
# The lab code is split into vagrant/*.rb (see vagrant/README.md), loaded in
# order below; this file keeps the banner and the Vagrant.configure block.
#
# CHANGES FOR VIRTUALBOX (retained from the pre-merge VirtualBox file):
# - Replaced libvirt provider with VirtualBox
# - Converted VLAN networks to VirtualBox internal networks
# - Updated network configuration for VirtualBox compatibility
# - Preserved all DC01 and OPNsense logic
# - Maintained VLAN segmentation with VirtualBox internal networks
# - Preserved all attack vectors and security configurations
# - FIX: Added missing MAC address stability for all interfaces
# - FIX: Added proper write_lab_hosts for all Linux VMs (including llm01, cloud-pentest, juice-shop)
# - FIX: Added missing Linux network configuration for all Linux VMs
# - FIX: Added Internet isolation for all Windows VMs (remove NAT default route)
# - FIX: Added complete LLM01 OWASP Top 10 modules

# ------------------------------------------------------------
# LAB CODE (vagrant/) - loaded in this order; the order matters
# because each file may use constants defined by the ones before it.
# ------------------------------------------------------------
require_relative '../base/vagrant/provider_detect'  # PROVIDER, LAB_GUI (same code as the base lab)
require_relative 'vagrant/domain'           # DOMAIN_NAME, DC_IP, build_domain_dn
require_relative 'vagrant/provision'        # provision/ loader and escaping helpers
require_relative 'vagrant/settings'         # passwords, WinRM timeouts, WAN constants
require_relative 'vagrant/host'             # RAM / CPU / KVM / disk detection
require_relative 'vagrant/profiles'         # PROFILES and the active LAB_PROFILE
require_relative 'vagrant/vm_config'        # VM_CONFIG
require_relative 'vagrant/network'          # VLAN_CONFIG, vlan_ip, MACs
require_relative 'vagrant/preflight'        # libvirt networks, host requirement check
require_relative 'vagrant/startup'          # plugins, networks and the banner (runs at load)
require_relative 'vagrant/providers'        # NICs, libvirt / VirtualBox settings
require_relative 'vagrant/windows'          # Windows guest helpers
require_relative 'vagrant/linux'            # Linux guest helpers
require_relative 'vagrant/global'           # configure_global
require_relative 'vagrant/machine'          # define_vm
require_relative 'vagrant/roles/opnsense'
require_relative 'vagrant/roles/dc01'
require_relative 'vagrant/roles/kali'
require_relative 'vagrant/roles/ca01-esc'
require_relative 'vagrant/roles/db01'
require_relative 'vagrant/roles/win10'
require_relative 'vagrant/roles/print01'
require_relative 'vagrant/roles/llm01'
require_relative 'vagrant/roles/cloud-pentest'
require_relative 'vagrant/roles/juice-shop'

# ==============================================================================
# VAGRANT CONFIGURATION
# ==============================================================================
Vagrant.configure("2") do |config|
  configure_global(config)

  PROFILES[LAB_PROFILE][:vms].each do |vm_name|
    vm_config = VM_CONFIG[vm_name]
    next unless vm_config

    define_vm(config, vm_name, vm_config)
  end
end
