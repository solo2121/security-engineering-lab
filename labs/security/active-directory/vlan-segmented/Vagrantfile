          awslocal iam create-role --role-name VulnerableRole --assume-role-policy-document '{"Version":"2012-10-17","Statement":[{"Effect":"Allow","Principal":{"Service":"ec2.amazonaws.com"},"Action":"sts:AssumeRole"}]}'
          awslocal iam put-role-policy --role-name VulnerableRole --policy-name EscalatePolicy --policy-document file:///opt/cloud-lab/iam-escalation-policy.json

          awslocal lambda create-function --function-name vulnerable-lambda \
            --runtime python3.9 --role arn:aws:iam::000000000000:role/VulnerableRole \
            --handler lambda_function.handler \
            --code '{"ZipFile":"aW1wb3J0IG9zCmRlZiBoYW5kbGVyKGV2ZW50LCBjb250ZXh0KToKICAgIHByaW50KCJEQl9QQVNTV09SRD0iICsgb3MuZ2V0ZW52KCJEQl9QQVNTV09SRCIsICJEZWZhdWx0UGFzczEyMyEiKSkKICAgIHJldHVybiB7CiAgICAgICAgJ3N0YXR1c0NvZGUnOiAyMDAsCiAgICAgICAgJ2JvZHknOiAnSGVsbG8gZnJvbSBMYW1iZGEnCiAgICB9Cg=="}' \
            --environment '{"Variables":{"DB_PASSWORD":"LambdaDbPass123!"}}' 2>/dev/null

          awslocal secretsmanager create-secret --name vulnerable-secret \
            --secret-string '{"password":"SecretManagerPass123!","api_key":"sk-1234567890"}' 2>/dev/null

          awslocal ec2 run-instances --image-id ami-12345678 --instance-type t2.micro \
            --user-data '#!/bin/bash\necho "DB_PASSWORD=Ec2DbPass123!" > /etc/db_credentials' 2>/dev/null

          awslocal iam create-user --user-name overprivileged-user 2>/dev/null
          awslocal iam create-access-key --user-name overprivileged-user 2>/dev/null
          awslocal iam attach-user-policy --user-name overprivileged-user --policy-arn arn:aws:iam::aws:policy/AdministratorAccess 2>/dev/null

          cat > /opt/cloud-lab/metadata_simulator.py << 'EOF'
        #!/usr/bin/env python3
        from flask import Flask, jsonify
        app = Flask(__name__)

        @app.route('/latest/meta-data/iam/security-credentials/', methods=['GET'])
