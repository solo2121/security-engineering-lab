            $type = [System.Security.AccessControl.AccessControlType]"Allow"
            $guid = New-Object Guid "a05b8cc1-17b4-44cc-a680-0f36ae5c10e8"
            $ace = New-Object System.DirectoryServices.ActiveDirectoryAccessRule($identity, $rights, $type, $guid)
            $acl.AddAccessRule($ace)
            Set-Acl "AD:\\$caPath" $acl
            Write-Log "ESC7 permissions granted"
          } catch {
            Write-Log "WARN: ESC7 setup failed: $_"
          }
          
          Restart-Service certsvc -Force
          
          Add-DnsServerResourceRecordA -Name "CA01-ESC" -ZoneName "#{DOMAIN_NAME}" -IPv4Address "#{vm_ip}" -ErrorAction SilentlyContinue
          
          Write-Log "ESC VULNERABILITIES CONFIGURED SUCCESSFULLY"
          "CA01-ESC fully configured with ESC vulns" | Out-File C:\\CA01-ESC-COMPLETE.txt -Force
        SHELL
        
        disable_internet_gateway(vm, "ca01-esc")
        
      when 'DB01'
        vm.vm.provision "shell", name: "db-config", privileged: true, run: "once", inline: <<-SHELL
          $LogDir = "C:\\LabLogs"
          New-Item -ItemType Directory -Path $LogDir -Force -ErrorAction SilentlyContinue
          Write-Host "Configuring DB01"
          Set-SmbServerConfiguration -RequireSecuritySignature $false -Force -ErrorAction SilentlyContinue
          New-NetFirewallRule -DisplayName "SMB" -Direction Inbound -Protocol TCP -LocalPort 445 -Action Allow
          "DB01 configured" | Out-File C:\\DB01-COMPLETE.txt -Force
        SHELL
        
        disable_internet_gateway(vm, "db01")
        
      when 'WIN10'
        vm.vm.provision "shell", name: "win10-config", privileged: true, run: "once", inline: <<-'SHELL'
          $LogDir = "C:\\LabLogs"
          New-Item -ItemType Directory -Path $LogDir -Force -ErrorAction SilentlyContinue
          Write-Host "Configuring WIN10"
          net user localadmin P@ssw0rd! /add
          net localgroup administrators localadmin /add
          Set-ItemProperty -Path 'HKLM:\System\CurrentControlSet\Control\Terminal Server' -Name "fDenyTSConnections" -Value 0
          Enable-NetFirewallRule -DisplayGroup "Remote Desktop"
          
          reg add "HKLM\SOFTWARE\Microsoft\Windows\CurrentVersion\Policies\System\Kerberos" /v "EnableKeyTrust" /t REG_DWORD /d 1 /f 2>$null
          reg add "HKLM\SYSTEM\CurrentControlSet\Control\Lsa" /v "UseLogonCredential" /t REG_DWORD /d 1 /f 2>$null
          reg add "HKLM\SYSTEM\CurrentControlSet\Control\SecurityProviders\WDigest" /v "UseLogonCredential" /t REG_DWORD /d 1 /f 2>$null
          schtasks /create /tn "VulnerableTask" /tr "cmd /c whoami" /sc daily /ru SYSTEM /f 2>$null
          
          "WIN10 configured" | Out-File C:\\WIN10-COMPLETE.txt -Force
        SHELL
        
        disable_internet_gateway(vm, "win10")
        
      when 'print01'
        vm.vm.provision "shell", name: "print-config", privileged: true, run: "once", inline: <<-'SHELL'
          $LogDir = "C:\\LabLogs"
          New-Item -ItemType Directory -Path $LogDir -Force -ErrorAction SilentlyContinue
          Write-Host "Configuring PRINT01"
          Install-WindowsFeature Print-Services
          New-Item -Path "HKLM:\SOFTWARE\Policies\Microsoft\Windows NT\Printers\PointAndPrint" -Force
          reg add "HKLM\SOFTWARE\Policies\Microsoft\Windows NT\Printers\PointAndPrint" /v RestrictDriverInstallationToAdministrators /t REG_DWORD /d 0 /f
          
          reg add "HKLM\SYSTEM\CurrentControlSet\Control\Print" /v "RpcAuthnLevelPrivacyEnabled" /t REG_DWORD /d 0 /f 2>$null
          reg add "HKLM\SYSTEM\CurrentControlSet\Control\Print" /v "AllowInsecureGuestAuth" /t REG_DWORD /d 1 /f 2>$null
          reg add "HKLM\Software\Policies\Microsoft\Windows NT\Printers" /v "RegisterSpoolerRemoteRpcEndPoint" /t REG_DWORD /d 2 /f 2>$null
          
          Add-PrinterDriver -Name "Microsoft Print To PDF" -ErrorAction SilentlyContinue
          Add-Printer -Name "VulnerablePrinter" -DriverName "Microsoft Print To PDF" -Shared -Published -ErrorAction SilentlyContinue
          New-NetFirewallRule -DisplayName "Printer Sharing SMB" -Direction Inbound -Protocol TCP -LocalPort 445 -Action Allow
          net localgroup administrators "DOMAIN\Domain Users" /add 2>$null
          
          "PRINT01 configured" | Out-File C:\\PRINT01-COMPLETE.txt -Force
