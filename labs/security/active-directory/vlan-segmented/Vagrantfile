          echo "SSH_KEY_BASE64: LS0tLS1CRUdJTiBSU0EgUFJJVkFURSBLRVktLS0tLQpNaWJveW91dGhpbmcK" > /opt/cloud-lab/s3-data/ssh_backup.txt
          awslocal s3 cp /opt/cloud-lab/s3-data/leaked_creds.txt s3://public-bucket/
          awslocal s3 cp /opt/cloud-lab/s3-data/db_passwords.txt s3://public-bucket/
          awslocal s3 cp /opt/cloud-lab/s3-data/ssh_backup.txt s3://internal-docs/
          awslocal s3api put-bucket-versioning --bucket backup-data --versioning-configuration Status=Suspended

          cat > /opt/cloud-lab/iam-escalation-policy.json << 'EOF'
        {
