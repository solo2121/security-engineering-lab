def build_domain_dn(domain_name)
  domain_name.split(".").map { |part| "DC=#{part}" }.join(",")
end

# ------------------------------------------------------------
# POWERSHELL STRING-ESCAPING HELPERS (NON-BREAKING)
# ------------------------------------------------------------
def ps_squote_escape(str)
  str.to_s.gsub("'", "''")
end

def ps_dquote_escape(str)
  str.to_s.gsub('`', '``').gsub('$', '`$').gsub('"', '`"')
end

